---
/**
 * StoryLine — 居場所からスモールステップで学びへ向かうビジョン
 *
 * 1本のSVG線が画面を縦に貫き、5つのステップを繋ぐ。
 * 各ステップに手描きイラスト + テキスト。
 * 線はスクロール連動で描画（GSAP）、CSSフォールバック有り。
 */

const steps = [
  {
    id: 'step-arrive',
    label: 'STEP 1',
    title: 'ここに来る',
    text: 'やる気がなくても大丈夫。ドアは開いている。まずは、ここに来るだけでいい。',
    color: 'var(--color-sakura-hai)',
    accent: 'var(--color-you-daidai)',
    side: 'right',
  },
  {
    id: 'step-belong',
    label: 'STEP 2',
    title: '居場所ができる',
    text: '温かいお茶。「今日どうだった？」。自分のペースでいられる場所。安心が生まれる。',
    color: '#E8F8F5',
    accent: 'var(--color-sora-mizu)',
    side: 'left',
  },
  {
    id: 'step-curiosity',
    label: 'STEP 3',
    title: '「なんで？」が芽生える',
    text: '先生が問いかける。「なんでだと思う？」。答えを教えない。自分で考える楽しさに出会う。',
    color: '#FDF8E8',
    accent: 'var(--color-tatami-kin)',
    side: 'right',
  },
  {
    id: 'step-challenge',
    label: 'STEP 4',
    title: '挑戦してみる',
    text: '「ちょっとやってみる？」。小さな一歩。間違えても大丈夫。ここでは誰も笑わない。',
    color: '#FFF0E8',
    accent: 'var(--color-you-daidai)',
    side: 'left',
  },
  {
    id: 'step-grow',
    label: 'STEP 5',
    title: '自分の力で学ぶ',
    text: '「わかった！」の瞬間。自分で考え、自分で見つけた答え。それが一生の力になる。',
    color: '#F0F0F5',
    accent: 'var(--color-sora-mizu)',
    side: 'right',
  },
];
---

<section class="storyline" id="storyline" aria-label="居場所から学びへのストーリー">
  <div class="storyline-header appear">
    <p class="storyline-label text-latin">Our Vision</p>
    <h2 class="storyline-title">居場所から、学びへ。</h2>
    <p class="storyline-subtitle">一人ひとりのペースで。スモールステップで。</p>
  </div>

  <div class="storyline-container">
    <!-- Central SVG line -->
    <svg class="storyline-svg" viewBox="0 0 100 2000" preserveAspectRatio="none" aria-hidden="true">
      <!-- Main journey line -->
      <path
        class="storyline-path"
        d="M50,0 Q50,100 50,200 Q30,350 50,400 Q70,450 50,600 Q30,750 50,800 Q70,950 50,1000 Q30,1150 50,1200 Q70,1350 50,1400 Q50,1600 50,1700 Q50,1900 50,2000"
        stroke="var(--color-primary)"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
      />
      <!-- Step dots on the line -->
      <circle class="storyline-dot storyline-dot-1" cx="50" cy="200" r="8" fill="var(--color-you-daidai)" />
      <circle class="storyline-dot storyline-dot-2" cx="50" cy="560" r="8" fill="var(--color-sora-mizu)" />
      <circle class="storyline-dot storyline-dot-3" cx="50" cy="920" r="8" fill="var(--color-tatami-kin)" />
      <circle class="storyline-dot storyline-dot-4" cx="50" cy="1280" r="8" fill="var(--color-you-daidai)" />
      <circle class="storyline-dot storyline-dot-5" cx="50" cy="1640" r="8" fill="var(--color-sora-mizu)" />
    </svg>

    <!-- Step cards -->
    <div class="storyline-steps">
      {steps.map((step, i) => (
        <div
          class:list={['storyline-step', `storyline-step--${step.side}`, 'appear']}
          id={step.id}
          style={`--step-bg: ${step.color}; --step-accent: ${step.accent}`}
        >
          <div class="storyline-step-content">
            <span class="storyline-step-label text-latin">{step.label}</span>
            <h3 class="storyline-step-title">{step.title}</h3>
            <p class="storyline-step-text">{step.text}</p>
          </div>
          <div class="storyline-step-illustration" aria-hidden="true">
            {/* Step 1: Door / arriving */}
            {i === 0 && (
              <svg viewBox="0 0 140 140" fill="none">
                <rect x="35" y="20" width="70" height="100" rx="4" stroke="var(--step-accent)" stroke-width="2" />
                <path d="M35,40 L105,40" stroke="var(--step-accent)" stroke-width="1" opacity="0.3" />
                <rect x="50" y="50" width="35" height="65" rx="2" stroke="var(--step-accent)" stroke-width="2" />
                <circle cx="80" cy="82" r="3" fill="var(--step-accent)" />
                <g transform="translate(10, 70)">
                  <circle cx="10" cy="8" r="8" stroke="var(--color-primary)" stroke-width="1.5" />
                  <path d="M7,6 Q8.5,4 10,6" stroke="var(--color-primary)" stroke-width="1" stroke-linecap="round" />
                  <path d="M12,6 Q13.5,4 15,6" stroke="var(--color-primary)" stroke-width="1" stroke-linecap="round" />
                  <path d="M10,16 L10,35" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M10,23 L3,30" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M10,23 L17,20" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M10,35 L5,48" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M10,35 L16,46" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                </g>
              </svg>
            )}
            {/* Step 2: Warm cup / belonging */}
            {i === 1 && (
              <svg viewBox="0 0 140 140" fill="none">
                <path d="M40,60 L40,110 Q40,120 50,120 L90,120 Q100,120 100,110 L100,60 Z" stroke="var(--step-accent)" stroke-width="2" stroke-linejoin="round" />
                <path d="M100,75 Q115,75 115,90 Q115,105 100,105" stroke="var(--step-accent)" stroke-width="2" stroke-linecap="round" />
                <path d="M55,55 Q55,40 60,35" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.4" />
                <path d="M70,50 Q70,35 75,28" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.3" />
                <path d="M85,55 Q85,42 88,38" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" opacity="0.4" />
                <circle cx="35" cy="40" r="12" stroke="var(--color-primary)" stroke-width="1.5" />
                <path d="M31,37 Q33,34 35,37" stroke="var(--color-primary)" stroke-width="1" stroke-linecap="round" />
                <path d="M37,37 Q39,34 41,37" stroke="var(--color-primary)" stroke-width="1" stroke-linecap="round" />
                <path d="M31,43 Q35,47 39,43" stroke="var(--color-you-daidai)" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            )}
            {/* Step 3: Question mark / curiosity */}
            {i === 2 && (
              <svg viewBox="0 0 140 140" fill="none">
                <circle cx="70" cy="50" r="14" stroke="var(--color-primary)" stroke-width="2" />
                <path d="M64,46 Q67,42 70,46" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                <path d="M72,46 Q75,42 78,46" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                <path d="M70,64 L70,95" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" />
                <path d="M70,75 L55,68" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                <path d="M70,75 L85,68" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                <g transform="translate(88, 20)">
                  <path d="M15,5 Q25,5 25,15 Q25,22 18,25 L18,30" stroke="var(--step-accent)" stroke-width="2.5" stroke-linecap="round" fill="none" />
                  <circle cx="18" cy="36" r="2" fill="var(--step-accent)" />
                </g>
                <path d="M40,95 Q55,80 60,100" stroke="var(--step-accent)" stroke-width="1" opacity="0.3" stroke-linecap="round" />
                <path d="M80,95 Q90,85 95,100" stroke="var(--step-accent)" stroke-width="1" opacity="0.3" stroke-linecap="round" />
              </svg>
            )}
            {/* Step 4: Small step / challenge */}
            {i === 3 && (
              <svg viewBox="0 0 140 140" fill="none">
                <path d="M20,120 L45,100 L70,85 L95,65 L120,40" stroke="var(--step-accent)" stroke-width="2" stroke-linecap="round" stroke-dasharray="6 4" />
                <circle cx="45" cy="100" r="4" fill="var(--step-accent)" opacity="0.3" />
                <circle cx="70" cy="85" r="4" fill="var(--step-accent)" opacity="0.5" />
                <circle cx="95" cy="65" r="4" fill="var(--step-accent)" opacity="0.7" />
                <circle cx="120" cy="40" r="6" fill="var(--step-accent)" />
                <g transform="translate(55, 45)">
                  <circle cx="12" cy="8" r="10" stroke="var(--color-primary)" stroke-width="1.5" />
                  <path d="M8,6 Q10,3 12,6" stroke="var(--color-primary)" stroke-width="1" stroke-linecap="round" />
                  <path d="M14,6 Q16,3 18,6" stroke="var(--color-primary)" stroke-width="1" stroke-linecap="round" />
                  <path d="M8,12 Q12,16 16,12" stroke="var(--color-you-daidai)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M12,18 L12,38" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M12,26 L22,20" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M12,26 L2,32" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                </g>
              </svg>
            )}
            {/* Step 5: Lightbulb / self-powered learning */}
            {i === 4 && (
              <svg viewBox="0 0 140 140" fill="none">
                <g transform="translate(45, 10)">
                  <path d="M25,60 Q5,45 10,25 Q15,5 30,5 Q45,5 50,20 Q55,35 40,50 Q35,55 35,60 Z" stroke="var(--step-accent)" stroke-width="2" fill="var(--step-accent)" fill-opacity="0.1" />
                  <path d="M22,60 L38,60" stroke="var(--step-accent)" stroke-width="2" stroke-linecap="round" />
                  <path d="M24,65 L36,65" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M26,70 L34,70" stroke="var(--step-accent)" stroke-width="1" stroke-linecap="round" />
                  <path d="M30,0 L30,-8" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M15,8 L8,2" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M45,8 L52,2" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M5,30 L-3,30" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M55,25 L63,25" stroke="var(--step-accent)" stroke-width="1.5" stroke-linecap="round" />
                </g>
                <g transform="translate(50, 85)">
                  <circle cx="15" cy="8" r="10" stroke="var(--color-primary)" stroke-width="2" />
                  <path d="M10,5 Q12,2 14,5" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M18,5 Q20,2 22,5" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M10,12 Q15,18 20,12" stroke="var(--color-you-daidai)" stroke-width="2" stroke-linecap="round" />
                  <path d="M15,18 L15,35" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" />
                  <path d="M15,25 L0,18" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M15,25 L30,18" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
                </g>
              </svg>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .storyline {
    position: relative;
    padding: var(--space-section) 0;
    overflow: hidden;
  }

  /* Header */
  .storyline-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
    padding: 0 var(--space-md);
  }

  .storyline-label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-sm);
  }

  .storyline-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-sm);
  }

  .storyline-subtitle {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
    opacity: 0.6;
  }

  /* Container */
  .storyline-container {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  /* Central SVG line */
  .storyline-svg {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 100px;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* CSS fallback: line is visible by default */
  .storyline-path {
    stroke-dasharray: 5000;
    stroke-dashoffset: 0;
    opacity: 0.2;
    transition: opacity 0.5s;
  }

  /* When GSAP is active, it controls dashoffset */
  .storyline-path.gsap-controlled {
    opacity: 0.35;
  }

  .storyline-dot {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .storyline-dot.is-visible {
    opacity: 1;
  }

  /* CSS fallback: show all dots */
  @media (prefers-reduced-motion: reduce) {
    .storyline-dot { opacity: 1; }
    .storyline-path { stroke-dashoffset: 0 !important; opacity: 0.25; }
  }

  /* Steps */
  .storyline-steps {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .storyline-step {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    max-width: 420px;
  }

  .storyline-step--right {
    margin-left: auto;
    margin-right: 0;
    flex-direction: row;
  }

  .storyline-step--left {
    margin-left: 0;
    margin-right: auto;
    flex-direction: row-reverse;
  }

  .storyline-step-content {
    flex: 1;
    padding: var(--space-lg);
    background: var(--step-bg);
    border-radius: var(--radius-lg);
    position: relative;
  }

  .storyline-step-content::before {
    content: '';
    position: absolute;
    top: 50%;
    width: 3px;
    height: 20px;
    background: var(--step-accent);
    border-radius: 2px;
    transform: translateY(-50%);
  }

  .storyline-step--right .storyline-step-content::before {
    left: -20px;
  }

  .storyline-step--left .storyline-step-content::before {
    right: -20px;
  }

  .storyline-step-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--step-accent);
    margin-bottom: var(--space-xs);
  }

  .storyline-step-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .storyline-step-text {
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-text);
    opacity: 0.85;
  }

  /* Illustration */
  .storyline-step-illustration {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
  }

  .storyline-step-illustration svg {
    width: 100%;
    height: 100%;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .storyline-svg {
      left: 24px;
      transform: none;
      width: 50px;
    }

    .storyline-step {
      max-width: 100%;
      margin-left: 50px !important;
      margin-right: 0 !important;
      flex-direction: row !important;
    }

    .storyline-step--left {
      flex-direction: row !important;
    }

    .storyline-step-content::before {
      left: -16px !important;
      right: auto !important;
    }

    .storyline-step-illustration {
      display: none;
    }
  }
</style>

<script>
  // GSAP enhancement for storyline — progressive drawing
  // Falls back to CSS (line visible, dots visible) without GSAP
  if (typeof window !== 'undefined') {
    import('gsap').then(({ gsap }) => {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isMobile = window.innerWidth < 768;

        if (prefersReducedMotion || isMobile) return;

        const path = document.querySelector('.storyline-path') as SVGPathElement;
        const dots = document.querySelectorAll('.storyline-dot');

        if (!path) return;

        const pathLength = path.getTotalLength();
        path.style.strokeDasharray = String(pathLength);
        path.style.strokeDashoffset = String(pathLength);
        path.classList.add('gsap-controlled');

        // Draw line on scroll
        ScrollTrigger.create({
          trigger: '.storyline',
          start: 'top 60%',
          end: 'bottom 40%',
          scrub: 0.5,
          onUpdate: (self) => {
            path.style.strokeDashoffset = String(pathLength * (1 - self.progress));

            // Show dots as line reaches them
            dots.forEach((dot, i) => {
              const threshold = (i + 1) / (dots.length + 1);
              if (self.progress > threshold - 0.05) {
                dot.classList.add('is-visible');
              }
            });
          },
        });
      });
    }).catch(() => {
      // GSAP not available — CSS fallback already handles it
    });
  }
</script>
