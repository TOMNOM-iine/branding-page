---
/**
 * StoryLine — 居場所からスモールステップで学びへ向かうビジョン
 *
 * 1本の大きな有機的SVG曲線が画面全幅を使って蛇行し、5つのステップを繋ぐ。
 * 線はスクロールで「生まれていく」ように描画される。
 * 各ステップではドットが脈打ち、枝分かれの小さな線が芽生える。
 * CSSフォールバック有り。
 */

const steps = [
  {
    id: 'step-arrive',
    label: 'STEP 1',
    title: 'ここに来る',
    text: 'やる気がなくても大丈夫。ドアは開いている。まずは、ここに来るだけでいい。',
    accent: 'var(--color-you-daidai)',
    side: 'right',
  },
  {
    id: 'step-belong',
    label: 'STEP 2',
    title: '居場所ができる',
    text: '温かいお茶。「今日どうだった？」。自分のペースでいられる場所。安心が生まれる。',
    accent: 'var(--color-sora-mizu)',
    side: 'left',
  },
  {
    id: 'step-curiosity',
    label: 'STEP 3',
    title: '「なんで？」が芽生える',
    text: '先生が問いかける。「なんでだと思う？」。答えを教えない。自分で考える楽しさに出会う。',
    accent: 'var(--color-tatami-kin)',
    side: 'right',
  },
  {
    id: 'step-challenge',
    label: 'STEP 4',
    title: '挑戦してみる',
    text: '「ちょっとやってみる？」。小さな一歩。間違えても大丈夫。ここでは誰も笑わない。',
    accent: 'var(--color-you-daidai)',
    side: 'left',
  },
  {
    id: 'step-grow',
    label: 'STEP 5',
    title: '自分の力で学ぶ',
    text: '「わかった！」の瞬間。自分で考え、自分で見つけた答え。それが一生の力になる。',
    accent: 'var(--color-sora-mizu)',
    side: 'right',
  },
];
---

<section class="storyline" id="storyline" aria-label="居場所から学びへのストーリー">
  <div class="storyline-header appear">
    <p class="storyline-label text-latin">Our Vision</p>
    <h2 class="storyline-title">居場所から、学びへ。</h2>
    <p class="storyline-subtitle">一人ひとりのペースで。スモールステップで。</p>
  </div>

  <div class="storyline-canvas">
    <!-- Full-width SVG with sweeping organic curve -->
    <svg class="storyline-svg" viewBox="0 0 1200 3000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <!-- Glow filter for the line tip -->
        <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="6" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <!-- Gradient along the path -->
        <linearGradient id="line-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#FF6B35" stop-opacity="0.15" />
          <stop offset="20%" stop-color="#4ECDC4" stop-opacity="0.25" />
          <stop offset="40%" stop-color="#E8D44D" stop-opacity="0.3" />
          <stop offset="60%" stop-color="#FF6B35" stop-opacity="0.35" />
          <stop offset="80%" stop-color="#4ECDC4" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#1A1A2E" stop-opacity="0.5" />
        </linearGradient>
      </defs>

      <!-- Shadow/echo line (wider, more transparent) -->
      <path
        class="storyline-echo"
        d="M600,0 Q600,80 600,150
           Q200,300 300,500
           Q400,650 800,550
           Q1050,480 900,750
           Q750,950 400,900
           Q150,860 300,1100
           Q450,1300 800,1200
           Q1000,1150 900,1400
           Q800,1600 400,1550
           Q200,1520 300,1750
           Q400,1950 700,1900
           Q900,1870 800,2100
           Q700,2300 500,2350
           Q400,2400 500,2500
           Q600,2600 600,2800
           Q600,2900 600,3000"
        stroke="url(#line-gradient)"
        stroke-width="40"
        fill="none"
        stroke-linecap="round"
        opacity="0.08"
      />

      <!-- Main journey line — large sweeping curves -->
      <path
        class="storyline-path"
        d="M600,0 Q600,80 600,150
           Q200,300 300,500
           Q400,650 800,550
           Q1050,480 900,750
           Q750,950 400,900
           Q150,860 300,1100
           Q450,1300 800,1200
           Q1000,1150 900,1400
           Q800,1600 400,1550
           Q200,1520 300,1750
           Q400,1950 700,1900
           Q900,1870 800,2100
           Q700,2300 500,2350
           Q400,2400 500,2500
           Q600,2600 600,2800
           Q600,2900 600,3000"
        stroke="var(--color-primary)"
        stroke-width="2.5"
        fill="none"
        stroke-linecap="round"
      />

      <!-- Branching tendrils at each step — "life sprouting" -->
      <!-- Step 1 branches -->
      <g class="storyline-branch storyline-branch-1">
        <path d="M400,400 Q350,350 320,300" stroke="var(--color-you-daidai)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M400,400 Q430,340 480,320" stroke="var(--color-you-daidai)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <circle cx="320" cy="300" r="4" fill="var(--color-you-daidai)" opacity="0" />
        <circle cx="480" cy="320" r="3" fill="var(--color-you-daidai)" opacity="0" />
      </g>

      <!-- Step 2 branches -->
      <g class="storyline-branch storyline-branch-2">
        <path d="M800,600 Q850,550 900,520" stroke="var(--color-sora-mizu)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M750,650 Q700,600 650,580" stroke="var(--color-sora-mizu)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <circle cx="900" cy="520" r="4" fill="var(--color-sora-mizu)" opacity="0" />
        <circle cx="650" cy="580" r="3" fill="var(--color-sora-mizu)" opacity="0" />
      </g>

      <!-- Step 3 branches -->
      <g class="storyline-branch storyline-branch-3">
        <path d="M400,1000 Q350,950 280,940" stroke="var(--color-tatami-kin)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M450,1050 Q500,1000 550,980" stroke="var(--color-tatami-kin)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M350,1050 Q300,1020 260,1030" stroke="var(--color-tatami-kin)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <circle cx="280" cy="940" r="4" fill="var(--color-tatami-kin)" opacity="0" />
        <circle cx="550" cy="980" r="3" fill="var(--color-tatami-kin)" opacity="0" />
        <circle cx="260" cy="1030" r="3" fill="var(--color-tatami-kin)" opacity="0" />
      </g>

      <!-- Step 4 branches (more!) -->
      <g class="storyline-branch storyline-branch-4">
        <path d="M800,1300 Q850,1250 920,1240" stroke="var(--color-you-daidai)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M750,1350 Q700,1300 640,1280" stroke="var(--color-you-daidai)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M850,1350 Q900,1320 940,1340" stroke="var(--color-you-daidai)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M700,1400 Q650,1380 600,1390" stroke="var(--color-you-daidai)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <circle cx="920" cy="1240" r="4" fill="var(--color-you-daidai)" opacity="0" />
        <circle cx="640" cy="1280" r="3" fill="var(--color-you-daidai)" opacity="0" />
        <circle cx="940" cy="1340" r="3" fill="var(--color-you-daidai)" opacity="0" />
        <circle cx="600" cy="1390" r="3" fill="var(--color-you-daidai)" opacity="0" />
      </g>

      <!-- Step 5 branches (most — blooming!) -->
      <g class="storyline-branch storyline-branch-5">
        <path d="M600,1900 Q550,1850 480,1830" stroke="var(--color-sora-mizu)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M650,1950 Q700,1900 760,1880" stroke="var(--color-sora-mizu)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M580,2000 Q520,1970 460,1980" stroke="var(--color-sora-mizu)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M680,2000 Q740,1970 800,1960" stroke="var(--color-sora-mizu)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M550,2050 Q490,2040 440,2060" stroke="var(--color-tatami-kin)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <path d="M700,2050 Q760,2030 820,2050" stroke="var(--color-you-daidai)" stroke-width="1" fill="none" stroke-linecap="round" opacity="0" />
        <circle cx="480" cy="1830" r="5" fill="var(--color-sora-mizu)" opacity="0" />
        <circle cx="760" cy="1880" r="5" fill="var(--color-sora-mizu)" opacity="0" />
        <circle cx="460" cy="1980" r="4" fill="var(--color-sora-mizu)" opacity="0" />
        <circle cx="800" cy="1960" r="4" fill="var(--color-sora-mizu)" opacity="0" />
        <circle cx="440" cy="2060" r="3" fill="var(--color-tatami-kin)" opacity="0" />
        <circle cx="820" cy="2050" r="3" fill="var(--color-you-daidai)" opacity="0" />
      </g>

      <!-- Main step dots (pulse) -->
      <circle class="storyline-dot storyline-dot-1" cx="350" cy="450" r="12" fill="var(--color-you-daidai)" opacity="0" />
      <circle class="storyline-dot storyline-dot-2" cx="850" cy="650" r="12" fill="var(--color-sora-mizu)" opacity="0" />
      <circle class="storyline-dot storyline-dot-3" cx="350" cy="1000" r="12" fill="var(--color-tatami-kin)" opacity="0" />
      <circle class="storyline-dot storyline-dot-4" cx="850" cy="1350" r="12" fill="var(--color-you-daidai)" opacity="0" />
      <circle class="storyline-dot storyline-dot-5" cx="600" cy="1950" r="14" fill="var(--color-sora-mizu)" opacity="0" />

      <!-- Pulse rings around dots -->
      <circle class="storyline-pulse storyline-pulse-1" cx="350" cy="450" r="12" fill="none" stroke="var(--color-you-daidai)" stroke-width="1" opacity="0" />
      <circle class="storyline-pulse storyline-pulse-2" cx="850" cy="650" r="12" fill="none" stroke="var(--color-sora-mizu)" stroke-width="1" opacity="0" />
      <circle class="storyline-pulse storyline-pulse-3" cx="350" cy="1000" r="12" fill="none" stroke="var(--color-tatami-kin)" stroke-width="1" opacity="0" />
      <circle class="storyline-pulse storyline-pulse-4" cx="850" cy="1350" r="12" fill="none" stroke="var(--color-you-daidai)" stroke-width="1" opacity="0" />
      <circle class="storyline-pulse storyline-pulse-5" cx="600" cy="1950" r="14" fill="none" stroke="var(--color-sora-mizu)" stroke-width="1" opacity="0" />
    </svg>

    <!-- Step cards overlaid on the curve -->
    <div class="storyline-steps">
      {steps.map((step, i) => (
        <div
          class:list={['storyline-step', `storyline-step--${step.side}`, 'appear']}
          id={step.id}
          style={`--step-accent: ${step.accent}; --step-index: ${i}`}
        >
          <div class="storyline-step-badge" aria-hidden="true">
            <span class="storyline-step-number">{i + 1}</span>
          </div>
          <div class="storyline-step-content">
            <span class="storyline-step-label text-latin">{step.label}</span>
            <h3 class="storyline-step-title">{step.title}</h3>
            <p class="storyline-step-text">{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Ending flourish -->
  <div class="storyline-ending appear">
    <p class="storyline-ending-text">
      この道のりは、一人ひとり違う。<br>
      でも、始まりはいつも同じ——<br>
      <strong>「ここに来てくれて、ありがとう。」</strong>
    </p>
  </div>
</section>

<style>
  .storyline {
    position: relative;
    padding: var(--space-2xl) 0 var(--space-section);
    overflow: hidden;
  }

  /* Header */
  .storyline-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    padding: 0 var(--space-md);
  }

  .storyline-label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-sm);
  }

  .storyline-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-sm);
  }

  .storyline-subtitle {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
    opacity: 0.6;
  }

  /* Canvas — full width SVG backdrop */
  .storyline-canvas {
    position: relative;
    min-height: 200vh;
  }

  .storyline-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Main line — CSS fallback */
  .storyline-path {
    stroke-dasharray: 8000;
    stroke-dashoffset: 0;
    opacity: 0.15;
    transition: opacity 1s ease;
  }

  .storyline-echo {
    opacity: 0.06;
  }

  /* GSAP controlled state */
  .storyline-path.gsap-controlled {
    opacity: 0.4;
  }

  .storyline-echo.gsap-controlled {
    opacity: 0.05;
  }

  /* Dots — CSS fallback shows them */
  .storyline-dot {
    opacity: 0;
    transition: opacity 0.8s var(--ease-out-expo), r 0.5s var(--ease-spring);
  }

  .storyline-dot.is-visible {
    opacity: 1;
  }

  /* Pulse rings */
  .storyline-pulse {
    opacity: 0;
  }

  .storyline-pulse.is-pulsing {
    opacity: 0.4;
    animation: dot-pulse 2s ease-out infinite;
  }

  @keyframes dot-pulse {
    0% { r: 12; opacity: 0.5; }
    100% { r: 35; opacity: 0; }
  }

  /* Branches — sprouting tendrils */
  .storyline-branch path,
  .storyline-branch circle {
    transition: opacity 0.8s var(--ease-out-expo);
  }

  .storyline-branch.is-sprouting path {
    opacity: 0.4;
  }

  .storyline-branch.is-sprouting circle {
    opacity: 0.6;
  }

  /* CSS fallback */
  @media (prefers-reduced-motion: reduce) {
    .storyline-dot { opacity: 0.8; }
    .storyline-path { stroke-dashoffset: 0 !important; opacity: 0.2; }
    .storyline-branch path { opacity: 0.3; }
    .storyline-branch circle { opacity: 0.4; }
    .storyline-pulse { display: none; }
  }

  /* Steps — overlaid cards */
  .storyline-steps {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(6rem, 15vw, 14rem);
    padding: var(--space-2xl) 0;
    max-width: 1100px;
    margin: 0 auto;
  }

  .storyline-step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    max-width: 400px;
    padding: 0 var(--space-md);
  }

  .storyline-step--right {
    margin-left: auto;
    margin-right: 10%;
  }

  .storyline-step--left {
    margin-left: 10%;
    margin-right: auto;
  }

  /* Step number badge */
  .storyline-step-badge {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--step-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px color-mix(in srgb, var(--step-accent) 40%, transparent);
    margin-top: var(--space-sm);
  }

  .storyline-step-number {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: var(--text-lg);
    color: white;
  }

  /* Step content */
  .storyline-step-content {
    flex: 1;
  }

  .storyline-step-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--step-accent);
    margin-bottom: var(--space-xs);
  }

  .storyline-step-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
    line-height: 1.3;
  }

  .storyline-step-text {
    font-size: var(--text-base);
    line-height: 2;
    color: var(--color-text);
    opacity: 0.8;
  }

  /* Ending */
  .storyline-ending {
    text-align: center;
    padding: var(--space-2xl) var(--space-md) 0;
  }

  .storyline-ending-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 2.2;
    color: var(--color-primary);
  }

  .storyline-ending-text strong {
    color: var(--color-secondary);
    font-size: var(--text-2xl);
    display: block;
    margin-top: var(--space-md);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .storyline-canvas {
      min-height: auto;
    }

    .storyline-svg {
      display: none;
    }

    .storyline-steps {
      gap: var(--space-xl);
      padding: var(--space-lg) 0;
      /* Mobile: vertical line via CSS border */
      border-left: 2px solid rgba(26, 26, 46, 0.1);
      margin-left: var(--space-lg);
      padding-left: var(--space-lg);
    }

    .storyline-step {
      max-width: 100%;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .storyline-step-badge {
      width: 36px;
      height: 36px;
      margin-left: calc(-1 * var(--space-lg) - 19px);
    }

    .storyline-step-number {
      font-size: var(--text-sm);
    }

    .storyline-step-title {
      font-size: var(--text-xl);
    }
  }
</style>

<script>
  // GSAP enhancement — line grows, dots bloom, tendrils sprout
  if (typeof window !== 'undefined') {
    import('gsap').then(({ gsap }) => {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isMobile = window.innerWidth < 768;

        if (prefersReducedMotion || isMobile) return;

        const path = document.querySelector('.storyline-path') as SVGPathElement;
        const echo = document.querySelector('.storyline-echo') as SVGPathElement;
        const dots = document.querySelectorAll('.storyline-dot');
        const pulses = document.querySelectorAll('.storyline-pulse');
        const branches = document.querySelectorAll('.storyline-branch');

        if (!path) return;

        // Setup
        const pathLength = path.getTotalLength();
        path.style.strokeDasharray = String(pathLength);
        path.style.strokeDashoffset = String(pathLength);
        path.classList.add('gsap-controlled');

        if (echo) {
          const echoLength = echo.getTotalLength();
          echo.style.strokeDasharray = String(echoLength);
          echo.style.strokeDashoffset = String(echoLength);
          echo.classList.add('gsap-controlled');
        }

        // Branch paths — setup stroke dash for drawing
        branches.forEach(branch => {
          branch.querySelectorAll('path').forEach(p => {
            const el = p as SVGPathElement;
            const len = el.getTotalLength();
            el.style.strokeDasharray = String(len);
            el.style.strokeDashoffset = String(len);
          });
        });

        // Main scroll animation
        ScrollTrigger.create({
          trigger: '.storyline-canvas',
          start: 'top 70%',
          end: 'bottom 30%',
          scrub: 0.8,
          onUpdate: (self) => {
            const progress = self.progress;

            // Draw main line
            path.style.strokeDashoffset = String(pathLength * (1 - progress));

            // Draw echo line slightly behind
            if (echo) {
              const echoLength = echo.getTotalLength();
              const echoProgress = Math.max(0, progress - 0.02);
              echo.style.strokeDashoffset = String(echoLength * (1 - echoProgress));
            }

            // Show dots as line reaches them — each with bloom effect
            dots.forEach((dot, i) => {
              const threshold = (i + 0.8) / (dots.length + 1);
              if (progress > threshold) {
                if (!dot.classList.contains('is-visible')) {
                  dot.classList.add('is-visible');
                  // Bloom animation
                  gsap.fromTo(dot, { attr: { r: 0 } }, {
                    attr: { r: i === 4 ? 14 : 12 },
                    duration: 0.6,
                    ease: 'elastic.out(1, 0.5)',
                  });
                  // Start pulse
                  if (pulses[i]) {
                    pulses[i].classList.add('is-pulsing');
                  }
                }
              }
            });

            // Sprout branches — progressively more at each step
            branches.forEach((branch, i) => {
              const threshold = (i + 1.2) / (branches.length + 1);
              if (progress > threshold) {
                if (!branch.classList.contains('is-sprouting')) {
                  branch.classList.add('is-sprouting');
                  // Animate branch paths drawing
                  branch.querySelectorAll('path').forEach((p, j) => {
                    gsap.to(p, {
                      strokeDashoffset: 0,
                      opacity: 0.4 - j * 0.05,
                      duration: 1.2,
                      delay: j * 0.15,
                      ease: 'expo.out',
                    });
                  });
                  // Animate branch dots appearing
                  branch.querySelectorAll('circle').forEach((c, j) => {
                    gsap.to(c, {
                      opacity: 0.6,
                      duration: 0.8,
                      delay: 0.3 + j * 0.1,
                      ease: 'expo.out',
                    });
                  });
                }
              }
            });
          },
        });
      });
    }).catch(() => {
      // CSS fallback
      document.querySelectorAll('.storyline-dot').forEach(d => d.classList.add('is-visible'));
      document.querySelectorAll('.storyline-branch').forEach(b => b.classList.add('is-sprouting'));
    });
  }
</script>
