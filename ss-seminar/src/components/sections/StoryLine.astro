---
/**
 * StoryLine — 居場所からスモールステップで学びへ
 *
 * 線は最初から薄く見えている。スクロールで「生まれる」=太く濃く輝く。
 * 下に行くほど枝分かれが増え、広がり・つながりを表現。
 * 1本 → 2本 → 3本 → 多くの線へ。
 */

const steps = [
  {
    id: 'step-arrive',
    label: 'STEP 1',
    title: 'ここに来る',
    text: 'やる気がなくても大丈夫。ドアは開いている。まずは、ここに来るだけでいい。',
    accent: 'var(--color-you-daidai)',
    side: 'right',
    imageAlt: '教室のドアを開ける子ども',
    imageHint: '教室入口・歓迎の雰囲気',
  },
  {
    id: 'step-belong',
    label: 'STEP 2',
    title: '居場所ができる',
    text: '温かいお茶。「今日どうだった？」。自分のペースでいられる場所。安心が生まれる。',
    accent: 'var(--color-sora-mizu)',
    side: 'left',
    imageAlt: '教室でリラックスする生徒たち',
    imageHint: '温かい教室の雰囲気・笑顔',
  },
  {
    id: 'step-curiosity',
    label: 'STEP 3',
    title: '「なんで？」が芽生える',
    text: '先生が問いかける。「なんでだと思う？」。答えを教えない。自分で考える楽しさに出会う。',
    accent: 'var(--color-tatami-kin)',
    side: 'right',
    imageAlt: '先生と対話する生徒',
    imageHint: 'ソクラテス問答法の対話風景',
  },
  {
    id: 'step-challenge',
    label: 'STEP 4',
    title: '挑戦してみる',
    text: '「ちょっとやってみる？」。小さな一歩。間違えても大丈夫。ここでは誰も笑わない。',
    accent: 'var(--color-you-daidai)',
    side: 'left',
    imageAlt: '問題に取り組む生徒',
    imageHint: '集中して学ぶ姿・ノートに書く',
  },
  {
    id: 'step-grow',
    label: 'STEP 5',
    title: '自分の力で学ぶ',
    text: '「わかった！」の瞬間。自分で考え、自分で見つけた答え。それが一生の力になる。',
    accent: 'var(--color-sora-mizu)',
    side: 'right',
    imageAlt: '達成感を感じる生徒の笑顔',
    imageHint: '笑顔・達成感・自信',
  },
];
---

<section class="storyline" id="storyline" aria-label="居場所から学びへのストーリー">
  <div class="storyline-header appear">
    <p class="storyline-label text-latin">Our Vision</p>
    <h2 class="storyline-title text-display">居場所から、学びへ。</h2>
    <p class="storyline-subtitle">一人ひとりのペースで。スモールステップで。</p>
  </div>

  <div class="storyline-canvas">
    <!-- Full-width SVG — lines ALWAYS visible (thin/faint), become alive on scroll -->
    <svg class="storyline-svg" viewBox="0 0 1200 3200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="line-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--color-you-daidai)" />
          <stop offset="30%" stop-color="var(--color-sora-mizu)" />
          <stop offset="60%" stop-color="var(--color-tatami-kin)" />
          <stop offset="100%" stop-color="var(--color-sora-mizu)" />
        </linearGradient>
      </defs>

      <!-- === LAYER 1: Main trunk — always visible thin, becomes thick === -->
      <path
        class="sline sline-trunk"
        d="M600,0 C600,200 250,300 350,550
           S850,500 800,750
           S200,900 350,1100
           S900,1200 800,1400
           S300,1500 400,1700
           S800,1900 700,2100
           S400,2300 500,2500
           C550,2650 600,2800 600,3000"
        stroke="var(--color-primary)"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
      />

      <!-- === LAYER 2: Second line — emerges at step 2 === -->
      <path
        class="sline sline-branch-a"
        d="M800,750 C900,850 950,1000 850,1100
           S650,1300 700,1500
           S550,1700 600,1900
           C650,2100 680,2400 650,2700"
        stroke="var(--color-sora-mizu)"
        stroke-width="1.5"
        fill="none"
        stroke-linecap="round"
      />

      <!-- === LAYER 3: Third line — emerges at step 3 === -->
      <path
        class="sline sline-branch-b"
        d="M350,1100 C200,1200 150,1400 250,1550
           S450,1700 400,1900
           S300,2100 350,2300
           C400,2500 500,2700 550,2900"
        stroke="var(--color-tatami-kin)"
        stroke-width="1.5"
        fill="none"
        stroke-linecap="round"
      />

      <!-- === LAYER 4: Spreading lines — emerge at step 4 === -->
      <path class="sline sline-spread-1" d="M700,1500 C800,1600 950,1650 1000,1800 S900,2000 950,2200 C970,2400 900,2600 850,2800" stroke="var(--color-you-daidai)" stroke-width="1" fill="none" stroke-linecap="round" />
      <path class="sline sline-spread-2" d="M400,1700 C300,1800 200,1900 180,2100 S250,2300 200,2500 C180,2650 220,2800 280,2900" stroke="var(--color-sora-mizu)" stroke-width="1" fill="none" stroke-linecap="round" />

      <!-- === LAYER 5: Blooming — step 5, many thin lines === -->
      <path class="sline sline-bloom-1" d="M600,2100 C500,2200 350,2250 300,2400 S350,2600 320,2800" stroke="var(--color-sora-mizu)" stroke-width="0.8" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-2" d="M700,2100 C800,2200 900,2300 920,2450 S880,2650 900,2850" stroke="var(--color-tatami-kin)" stroke-width="0.8" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-3" d="M500,2500 C400,2550 300,2600 250,2700 S280,2850 250,3000" stroke="var(--color-you-daidai)" stroke-width="0.8" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-4" d="M650,2500 C750,2550 850,2580 900,2700 S870,2850 900,3000" stroke="var(--color-sora-mizu)" stroke-width="0.8" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-5" d="M550,2700 C500,2750 430,2800 400,2900 S430,2980 420,3100" stroke="var(--color-tatami-kin)" stroke-width="0.6" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-6" d="M700,2700 C750,2780 800,2850 830,2950 S800,3050 820,3150" stroke="var(--color-you-daidai)" stroke-width="0.6" fill="none" stroke-linecap="round" />

      <!-- Step dots -->
      <circle class="sdot sdot-1" cx="350" cy="550" r="10" fill="var(--color-you-daidai)" />
      <circle class="sdot sdot-2" cx="800" cy="750" r="10" fill="var(--color-sora-mizu)" />
      <circle class="sdot sdot-3" cx="350" cy="1100" r="10" fill="var(--color-tatami-kin)" />
      <circle class="sdot sdot-4" cx="800" cy="1400" r="10" fill="var(--color-you-daidai)" />
      <circle class="sdot sdot-5" cx="600" cy="2100" r="12" fill="var(--color-sora-mizu)" />
    </svg>

    <!-- Step cards -->
    <div class="storyline-steps">
      {steps.map((step, i) => (
        <div
          class:list={['storyline-step', `storyline-step--${step.side}`, 'appear']}
          id={step.id}
          data-step={i + 1}
          style={`--step-accent: ${step.accent}`}
        >
          <div class="storyline-step-badge" aria-hidden="true">
            <span class="storyline-step-number">{i + 1}</span>
          </div>
          <div class="storyline-step-body">
            <div class="storyline-step-content">
              <span class="storyline-step-label text-latin">{step.label}</span>
              <h3 class="storyline-step-title">{step.title}</h3>
              <p class="storyline-step-text">{step.text}</p>
            </div>
            <div class="storyline-step-image" data-step={i + 1}>
              <div class="storyline-step-image-placeholder">
                <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
                  <rect x="10" y="18" width="60" height="44" rx="4" stroke="var(--step-accent)" stroke-width="1.5" opacity="0.3" />
                  <circle cx="30" cy="35" r="6" stroke="var(--step-accent)" stroke-width="1" opacity="0.3" />
                  <path d="M10,52 L30,38 L45,48 L55,40 L70,52 L70,62 L10,62 Z" fill="var(--step-accent)" opacity="0.08" />
                </svg>
                <span class="storyline-step-image-hint">{step.imageHint}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="storyline-ending appear">
    <p class="storyline-ending-text">
      この道のりは、一人ひとり違う。<br>
      でも、始まりはいつも同じ——<br>
      <strong>「ここに来てくれて、ありがとう。」</strong>
    </p>
  </div>
</section>

<style>
  .storyline {
    position: relative;
    padding: var(--space-2xl) 0 var(--space-section);
    overflow: hidden;
  }

  .storyline-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    padding: 0 var(--space-md);
  }

  .storyline-label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-sm);
  }

  .storyline-title { font-size: var(--text-3xl); margin-bottom: var(--space-sm); }

  .storyline-subtitle {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
    opacity: 0.6;
  }

  .storyline-canvas {
    position: relative;
    min-height: 200vh;
  }

  .storyline-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* ===== LINES — invisible → born (faint + flowing) → alive (vivid) ===== */
  .sline {
    opacity: 0;
    stroke-dasharray: 3000;
    stroke-dashoffset: 3000;
    transition: opacity 2s var(--ease-out-expo), stroke-width 1.5s var(--ease-out-expo);
  }

  /* Phase 1: born — faint ghost + line flows in */
  .sline.is-born {
    opacity: 0.1;
    animation: line-flow 4s var(--ease-out-expo) forwards;
  }

  .sline-trunk.is-born { opacity: 0.12; animation-duration: 3s; }
  .sline-branch-a.is-born { animation-duration: 3.5s; animation-delay: 0.5s; }
  .sline-branch-b.is-born { animation-duration: 3.5s; animation-delay: 1s; }
  .sline-spread-1.is-born { animation-duration: 4s; animation-delay: 1.5s; }
  .sline-spread-2.is-born { animation-duration: 4s; animation-delay: 2s; }
  .sline-bloom-1.is-born { animation-duration: 3s; animation-delay: 2.5s; }
  .sline-bloom-2.is-born { animation-duration: 3s; animation-delay: 2.7s; }
  .sline-bloom-3.is-born { animation-duration: 3s; animation-delay: 2.9s; }
  .sline-bloom-4.is-born { animation-duration: 3s; animation-delay: 3.1s; }
  .sline-bloom-5.is-born { animation-duration: 3s; animation-delay: 3.3s; }
  .sline-bloom-6.is-born { animation-duration: 3s; animation-delay: 3.5s; }

  @keyframes line-flow {
    0% { stroke-dashoffset: 3000; }
    100% { stroke-dashoffset: 0; }
  }

  /* Phase 2: alive — thick, vibrant, fully present */
  .sline.is-alive {
    opacity: 0.35;
    stroke-width: 3;
  }

  .sline-trunk.is-alive { opacity: 0.45; stroke-width: 3.5; }
  .sline-branch-a.is-alive { opacity: 0.3; stroke-width: 2.5; }
  .sline-branch-b.is-alive { opacity: 0.3; stroke-width: 2.5; }
  .sline-spread-1.is-alive,
  .sline-spread-2.is-alive { opacity: 0.25; stroke-width: 1.8; }
  .sline-bloom-1.is-alive,
  .sline-bloom-2.is-alive,
  .sline-bloom-3.is-alive,
  .sline-bloom-4.is-alive,
  .sline-bloom-5.is-alive,
  .sline-bloom-6.is-alive { opacity: 0.2; stroke-width: 1.2; }

  /* Dots — invisible initially, bloom when step activates */
  .sdot {
    opacity: 0;
    transition: opacity 0.8s var(--ease-out-expo);
  }

  .sdot.is-alive {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .sline {
      opacity: 0.15 !important;
      stroke-dashoffset: 0 !important;
      animation: none !important;
    }
    .sdot { opacity: 0.6 !important; }
  }

  /* No-JS fallback */
  :global(.no-js) .sline { opacity: 0.15; stroke-dashoffset: 0; animation: none; }
  :global(.no-js) .sdot { opacity: 0.6; }

  /* ===== STEPS ===== */
  .storyline-steps {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(6rem, 15vw, 14rem);
    padding: var(--space-2xl) 0;
    max-width: 1100px;
    margin: 0 auto;
  }

  .storyline-step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    max-width: 560px;
    padding: 0 var(--space-md);
  }

  .storyline-step--right { margin-left: auto; margin-right: 5%; }
  .storyline-step--left { margin-left: 5%; margin-right: auto; }

  .storyline-step-badge {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--step-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px color-mix(in srgb, var(--step-accent) 40%, transparent);
    margin-top: var(--space-sm);
  }

  .storyline-step-number {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: var(--text-lg);
    color: white;
  }

  .storyline-step-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .storyline-step-content { flex: 1; }

  .storyline-step-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--step-accent);
    margin-bottom: var(--space-xs);
  }

  .storyline-step-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
    line-height: 1.4;
    letter-spacing: 0.04em;
  }

  .storyline-step-text {
    font-size: var(--text-base);
    line-height: 2;
    color: var(--color-text);
    opacity: 0.8;
  }

  /* Image placeholder */
  .storyline-step-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-sumi-shiro);
    border: 1px solid rgba(26, 26, 46, 0.06);
  }

  .storyline-step-image img { width: 100%; height: 100%; object-fit: cover; }

  .storyline-step-image-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-sm);
    background: linear-gradient(135deg, rgba(26,26,46,0.02), rgba(26,26,46,0.04));
  }

  .storyline-step-image-placeholder svg { width: 80px; height: 80px; opacity: 0.5; }
  .storyline-step-image-hint { font-size: var(--text-xs); color: var(--color-text); opacity: 0.3; font-style: italic; }

  /* Ending */
  .storyline-ending {
    text-align: center;
    padding: var(--space-2xl) var(--space-md) 0;
  }

  .storyline-ending-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 2.2;
    color: var(--color-primary);
  }

  .storyline-ending-text strong {
    color: var(--color-secondary);
    font-size: var(--text-2xl);
    display: block;
    margin-top: var(--space-md);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .storyline-canvas { min-height: auto; }
    .storyline-svg { display: none; }

    .storyline-steps {
      gap: var(--space-xl);
      padding: var(--space-lg) 0;
      border-left: 2px solid rgba(26, 26, 46, 0.1);
      margin-left: var(--space-lg);
      padding-left: var(--space-lg);
    }

    .storyline-step {
      max-width: 100%;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .storyline-step-badge {
      width: 36px; height: 36px;
      margin-left: calc(-1 * var(--space-lg) - 19px);
    }

    .storyline-step-number { font-size: var(--text-sm); }
    .storyline-step-title { font-size: var(--text-xl); }
    .storyline-step-image { aspect-ratio: 16 / 9; }
  }
</style>

<script>
  /**
   * Animation: lines are always visible (thin/faint).
   * As each step enters viewport, associated lines "come alive" —
   * thicker, more opaque, vibrant. Creates a "birth" effect
   * without the line disappearing before the user sees it.
   *
   * Fallback: without JS, CSS shows all lines at low opacity.
   */
  if (typeof window !== 'undefined') {
    const isMobile = window.innerWidth < 768;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!isMobile && !prefersReducedMotion) {
      const allLines = document.querySelectorAll('.sline');

      // Phase 1: When storyline section enters viewport, all lines "are born" — faint ghostly appearance
      const birthObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            // Stagger birth of all lines for organic feel
            allLines.forEach((line, i) => {
              setTimeout(() => line.classList.add('is-born'), i * 200);
            });
            birthObserver.disconnect();
          });
        },
        { threshold: 0, rootMargin: '0px 0px 0px 0px' }
      );

      const storylineSection = document.querySelector('.storyline');
      if (storylineSection) birthObserver.observe(storylineSection);

      // Phase 2: Each step brings its lines fully alive
      // Step progression: trunk only → +branch → +branch → +spread → +bloom (everything)
      const stepLineMap: Record<number, string[]> = {
        1: ['.sline-trunk'],
        2: ['.sline-branch-a'],
        3: ['.sline-branch-b'],
        4: ['.sline-spread-1', '.sline-spread-2'],
        5: ['.sline-bloom-1', '.sline-bloom-2', '.sline-bloom-3', '.sline-bloom-4', '.sline-bloom-5', '.sline-bloom-6'],
      };

      const stepObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;

            const stepNum = Number(entry.target.getAttribute('data-step'));
            if (!stepNum) return;

            // Activate NEW lines for this step (staggered)
            const newSelectors = stepLineMap[stepNum] || [];
            newSelectors.forEach((sel, i) => {
              const el = document.querySelector(sel);
              if (el) {
                setTimeout(() => el.classList.add('is-alive'), i * 200);
              }
            });

            // Also make all PREVIOUS steps' lines alive (in case scrolled fast)
            for (let s = 1; s <= stepNum; s++) {
              (stepLineMap[s] || []).forEach(sel => {
                document.querySelector(sel)?.classList.add('is-alive');
              });
            }

            // Activate dot
            const dot = document.querySelector(`.sdot-${stepNum}`);
            if (dot) dot.classList.add('is-alive');
          });
        },
        { threshold: 0.3, rootMargin: '0px 0px -5% 0px' }
      );

      document.querySelectorAll('.storyline-step').forEach(step => {
        stepObserver.observe(step);
      });

      // Check already-visible elements on load
      const checkVisible = (el: Element) => {
        const rect = el.getBoundingClientRect();
        return rect.top < window.innerHeight && rect.bottom > 0;
      };

      if (storylineSection && checkVisible(storylineSection)) {
        allLines.forEach(line => line.classList.add('is-born'));
      }

      document.querySelectorAll('.storyline-step').forEach(step => {
        if (checkVisible(step)) {
          const stepNum = Number(step.getAttribute('data-step'));
          for (let s = 1; s <= stepNum; s++) {
            (stepLineMap[s] || []).forEach(sel => {
              const el = document.querySelector(sel);
              el?.classList.add('is-born');
              el?.classList.add('is-alive');
            });
            document.querySelector(`.sdot-${s}`)?.classList.add('is-alive');
          }
        }
      });
    }
  }
</script>
