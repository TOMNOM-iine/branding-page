---
/**
 * StoryLine — 居場所からスモールステップで学びへ
 *
 * 線は最初から薄く見えている。スクロールで「生まれる」=太く濃く輝く。
 * 下に行くほど枝分かれが増え、広がり・つながりを表現。
 * 1本 → 2本 → 3本 → 多くの線へ。
 */

const steps = [
  {
    id: 'step-arrive',
    label: 'STEP 1',
    title: 'ここに来る',
    text: 'やる気がなくても大丈夫。ドアは開いている。まずは、ここに来るだけでいい。',
    accent: 'var(--color-you-daidai)',
    side: 'right',
    imageAlt: '教室のドアを開ける子ども',
    imageHint: '教室入口・歓迎の雰囲気',
  },
  {
    id: 'step-belong',
    label: 'STEP 2',
    title: '居場所ができる',
    text: '温かいお茶。「今日どうだった？」。自分のペースでいられる場所。安心が生まれる。',
    accent: 'var(--color-sora-mizu)',
    side: 'left',
    imageAlt: '教室でリラックスする生徒たち',
    imageHint: '温かい教室の雰囲気・笑顔',
  },
  {
    id: 'step-curiosity',
    label: 'STEP 3',
    title: '「なんで？」が芽生える',
    text: '先生が問いかける。「なんでだと思う？」。答えを教えない。自分で考える楽しさに出会う。',
    accent: 'var(--color-tatami-kin)',
    side: 'right',
    imageAlt: '先生と対話する生徒',
    imageHint: 'ソクラテス問答法の対話風景',
  },
  {
    id: 'step-challenge',
    label: 'STEP 4',
    title: '挑戦してみる',
    text: '「ちょっとやってみる？」。小さな一歩。間違えても大丈夫。ここでは誰も笑わない。',
    accent: 'var(--color-you-daidai)',
    side: 'left',
    imageAlt: '問題に取り組む生徒',
    imageHint: '集中して学ぶ姿・ノートに書く',
  },
  {
    id: 'step-grow',
    label: 'STEP 5',
    title: '自分の力で学ぶ',
    text: '「わかった！」の瞬間。自分で考え、自分で見つけた答え。それが一生の力になる。',
    accent: 'var(--color-sora-mizu)',
    side: 'right',
    imageAlt: '達成感を感じる生徒の笑顔',
    imageHint: '笑顔・達成感・自信',
  },
];
---

<section class="storyline" id="storyline" aria-label="居場所から学びへのストーリー">
  <div class="storyline-header appear">
    <p class="storyline-label text-latin">Our Vision</p>
    <h2 class="storyline-title text-display">居場所から、学びへ。</h2>
    <p class="storyline-subtitle">一人ひとりのペースで。スモールステップで。</p>
  </div>

  <div class="storyline-canvas">
    <!-- Full-width SVG — lines ALWAYS visible (thin/faint), become alive on scroll -->
    <svg class="storyline-svg" viewBox="0 0 1200 3200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <!-- Brush texture filter — roughens edges like ink on paper -->
        <filter id="brush-texture" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="4" seed="2" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <!-- Heavier brush for trunk -->
        <filter id="brush-heavy" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="7" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>

      <!-- ====== INK SPLATTERS — wild, scattered, 野蛮 ====== -->
      <g class="ink-splatters" opacity="0.12">
        <!-- Splatter near step 1 -->
        <circle cx="380" cy="520" r="15" fill="var(--color-primary)" />
        <circle cx="395" cy="510" r="5" fill="var(--color-primary)" />
        <circle cx="365" cy="540" r="8" fill="var(--color-primary)" />
        <circle cx="410" cy="530" r="3" fill="var(--color-primary)" />
        <circle cx="340" cy="560" r="4" fill="var(--color-primary)" />
        <!-- Splatter near step 2 -->
        <circle cx="820" cy="720" r="12" fill="var(--color-primary)" />
        <circle cx="840" cy="740" r="6" fill="var(--color-primary)" />
        <circle cx="795" cy="760" r="4" fill="var(--color-primary)" />
        <circle cx="860" cy="710" r="3" fill="var(--color-primary)" />
        <!-- Splatter near step 3 — more scattered -->
        <circle cx="330" cy="1080" r="18" fill="var(--color-primary)" />
        <circle cx="310" cy="1060" r="7" fill="var(--color-primary)" />
        <circle cx="360" cy="1110" r="5" fill="var(--color-primary)" />
        <circle cx="295" cy="1090" r="4" fill="var(--color-primary)" />
        <circle cx="375" cy="1070" r="3" fill="var(--color-primary)" />
        <circle cx="345" cy="1130" r="6" fill="var(--color-primary)" />
        <!-- Splatter near step 4 — even wilder -->
        <circle cx="780" cy="1380" r="20" fill="var(--color-primary)" />
        <circle cx="810" cy="1360" r="8" fill="var(--color-primary)" />
        <circle cx="760" cy="1410" r="6" fill="var(--color-primary)" />
        <circle cx="830" cy="1400" r="4" fill="var(--color-primary)" />
        <circle cx="740" cy="1370" r="5" fill="var(--color-primary)" />
        <circle cx="850" cy="1390" r="3" fill="var(--color-primary)" />
        <circle cx="770" cy="1430" r="7" fill="var(--color-primary)" />
        <!-- Splatter near step 5 — explosive bloom -->
        <circle cx="580" cy="2080" r="25" fill="var(--color-primary)" />
        <circle cx="620" cy="2060" r="10" fill="var(--color-primary)" />
        <circle cx="550" cy="2110" r="8" fill="var(--color-primary)" />
        <circle cx="640" cy="2100" r="6" fill="var(--color-primary)" />
        <circle cx="560" cy="2050" r="5" fill="var(--color-primary)" />
        <circle cx="600" cy="2130" r="9" fill="var(--color-primary)" />
        <circle cx="530" cy="2090" r="4" fill="var(--color-primary)" />
        <circle cx="660" cy="2070" r="4" fill="var(--color-primary)" />
        <circle cx="580" cy="2150" r="7" fill="var(--color-primary)" />
      </g>

      <!-- ====== TRUNK — bold brush stroke, thick-thin variation ====== -->
      <!-- Multiple overlapping paths simulate brush pressure variation -->
      <g class="sline sline-trunk" filter="url(#brush-heavy)">
        <!-- Main thick stroke -->
        <path
          d="M600,0 C600,180 280,280 350,520
             S820,480 800,740
             S220,880 350,1080
             S880,1180 800,1380
             S320,1480 400,1680
             S780,1880 700,2080
             S420,2280 500,2480
             C550,2630 600,2780 600,2980"
          stroke="var(--color-primary)"
          stroke-width="8"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <!-- Thinner overlay for depth -->
        <path
          d="M600,0 C595,190 290,290 355,530
             S830,490 805,745
             S215,885 345,1085
             S885,1190 795,1385
             S315,1490 405,1685
             S785,1885 705,2085
             S415,2290 505,2490
             C555,2640 605,2790 605,2990"
          stroke="var(--color-primary)"
          stroke-width="3"
          fill="none"
          stroke-linecap="round"
          opacity="0.5"
        />
      </g>

      <!-- ====== BRANCHES — brush strokes that sprout ====== -->
      <path class="sline sline-branch-a" filter="url(#brush-texture)"
        d="M800,750 C890,840 940,980 850,1090 S660,1280 700,1480 S560,1680 610,1880 C660,2080 690,2380 660,2680"
        stroke="var(--color-primary)" stroke-width="5" fill="none" stroke-linecap="round" />

      <path class="sline sline-branch-b" filter="url(#brush-texture)"
        d="M350,1100 C210,1190 160,1380 260,1530 S460,1680 410,1880 S310,2080 360,2280 C410,2480 510,2680 560,2880"
        stroke="var(--color-primary)" stroke-width="5" fill="none" stroke-linecap="round" />

      <!-- ====== SPREADING — thinner brush strokes ====== -->
      <path class="sline sline-spread-1" filter="url(#brush-texture)"
        d="M700,1500 C790,1590 940,1640 990,1790 S890,1990 940,2190 C960,2390 890,2590 840,2790"
        stroke="var(--color-primary)" stroke-width="3.5" fill="none" stroke-linecap="round" />
      <path class="sline sline-spread-2" filter="url(#brush-texture)"
        d="M400,1700 C310,1790 210,1890 190,2090 S260,2290 210,2490 C190,2640 230,2790 290,2890"
        stroke="var(--color-primary)" stroke-width="3.5" fill="none" stroke-linecap="round" />

      <!-- ====== BLOOM — many wild brush strokes, explosive ====== -->
      <path class="sline sline-bloom-1" filter="url(#brush-texture)" d="M600,2100 C510,2190 360,2240 310,2390 S360,2590 330,2790" stroke="var(--color-primary)" stroke-width="2.5" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-2" filter="url(#brush-texture)" d="M700,2100 C790,2190 890,2290 910,2440 S870,2640 890,2840" stroke="var(--color-primary)" stroke-width="2.5" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-3" filter="url(#brush-texture)" d="M500,2500 C410,2540 310,2590 260,2690 S290,2840 260,2990" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-4" filter="url(#brush-texture)" d="M650,2500 C740,2540 840,2570 890,2690 S860,2840 890,2990" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-5" filter="url(#brush-texture)" d="M550,2700 C510,2740 440,2790 410,2890 S440,2970 430,3090" stroke="var(--color-primary)" stroke-width="1.5" fill="none" stroke-linecap="round" />
      <path class="sline sline-bloom-6" filter="url(#brush-texture)" d="M700,2700 C740,2770 790,2840 820,2940 S790,3040 810,3140" stroke="var(--color-primary)" stroke-width="1.5" fill="none" stroke-linecap="round" />

      <!-- ====== INK DOTS at steps — splattered, not perfect circles ====== -->
      <g class="sdot sdot-1" filter="url(#brush-heavy)">
        <circle cx="350" cy="550" r="14" fill="var(--color-primary)" />
        <circle cx="365" cy="540" r="5" fill="var(--color-primary)" />
        <circle cx="338" cy="565" r="4" fill="var(--color-primary)" />
      </g>
      <g class="sdot sdot-2" filter="url(#brush-heavy)">
        <circle cx="800" cy="750" r="14" fill="var(--color-primary)" />
        <circle cx="815" cy="738" r="5" fill="var(--color-primary)" />
        <circle cx="785" cy="762" r="4" fill="var(--color-primary)" />
      </g>
      <g class="sdot sdot-3" filter="url(#brush-heavy)">
        <circle cx="350" cy="1100" r="16" fill="var(--color-primary)" />
        <circle cx="370" cy="1088" r="6" fill="var(--color-primary)" />
        <circle cx="335" cy="1115" r="5" fill="var(--color-primary)" />
        <circle cx="365" cy="1118" r="3" fill="var(--color-primary)" />
      </g>
      <g class="sdot sdot-4" filter="url(#brush-heavy)">
        <circle cx="800" cy="1400" r="18" fill="var(--color-primary)" />
        <circle cx="822" cy="1388" r="7" fill="var(--color-primary)" />
        <circle cx="780" cy="1415" r="5" fill="var(--color-primary)" />
        <circle cx="815" cy="1420" r="4" fill="var(--color-primary)" />
        <circle cx="770" cy="1395" r="3" fill="var(--color-primary)" />
      </g>
      <g class="sdot sdot-5" filter="url(#brush-heavy)">
        <circle cx="600" cy="2100" r="22" fill="var(--color-primary)" />
        <circle cx="625" cy="2082" r="8" fill="var(--color-primary)" />
        <circle cx="575" cy="2118" r="7" fill="var(--color-primary)" />
        <circle cx="620" cy="2125" r="5" fill="var(--color-primary)" />
        <circle cx="580" cy="2080" r="4" fill="var(--color-primary)" />
        <circle cx="640" cy="2108" r="4" fill="var(--color-primary)" />
        <circle cx="560" cy="2095" r="3" fill="var(--color-primary)" />
      </g>
    </svg>

    <!-- Step cards -->
    <div class="storyline-steps">
      {steps.map((step, i) => (
        <div
          class:list={['storyline-step', `storyline-step--${step.side}`, 'appear']}
          id={step.id}
          data-step={i + 1}
          style={`--step-accent: ${step.accent}`}
        >
          <div class="storyline-step-badge" aria-hidden="true">
            <span class="storyline-step-number">{i + 1}</span>
          </div>
          <div class="storyline-step-body">
            <div class="storyline-step-content">
              <span class="storyline-step-label text-latin">{step.label}</span>
              <h3 class="storyline-step-title">{step.title}</h3>
              <p class="storyline-step-text">{step.text}</p>
            </div>
            <div class="storyline-step-image" data-step={i + 1}>
              <div class="storyline-step-image-placeholder">
                <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
                  <rect x="10" y="18" width="60" height="44" rx="4" stroke="var(--step-accent)" stroke-width="1.5" opacity="0.3" />
                  <circle cx="30" cy="35" r="6" stroke="var(--step-accent)" stroke-width="1" opacity="0.3" />
                  <path d="M10,52 L30,38 L45,48 L55,40 L70,52 L70,62 L10,62 Z" fill="var(--step-accent)" opacity="0.08" />
                </svg>
                <span class="storyline-step-image-hint">{step.imageHint}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="storyline-ending appear">
    <p class="storyline-ending-text">
      この道のりは、一人ひとり違う。<br>
      でも、始まりはいつも同じ——<br>
      <strong>「ここに来てくれて、ありがとう。」</strong>
    </p>
  </div>
</section>

<style>
  .storyline {
    position: relative;
    padding: var(--space-2xl) 0 var(--space-section);
    overflow: hidden;
  }

  .storyline-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    padding: 0 var(--space-md);
  }

  .storyline-label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-sm);
  }

  .storyline-title { font-size: var(--text-3xl); margin-bottom: var(--space-sm); }

  .storyline-subtitle {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
    opacity: 0.6;
  }

  .storyline-canvas {
    position: relative;
    min-height: 200vh;
  }

  .storyline-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* ===== INK SPLATTERS ===== */
  .ink-splatters {
    transition: opacity 1.5s var(--ease-out-expo);
  }

  /* ===== TRUNK — brush stroke, draws top to bottom via JS clip-path ===== */
  .sline-trunk {
    opacity: 0.55;
    clip-path: inset(0 0 100% 0);
    transition: opacity 1s var(--ease-out-expo);
  }

  .sline-trunk.is-alive { opacity: 0.65; }

  /* ===== BRANCHES — hidden, sprout with brush energy ===== */
  .sline:not(.sline-trunk) {
    opacity: 0;
    stroke-dasharray: 3000;
    stroke-dashoffset: 3000;
    transition: opacity 1s var(--ease-out-expo),
                stroke-dashoffset 3s var(--ease-out-expo);
  }

  .sline-branch-a.is-sprouting,
  .sline-branch-b.is-sprouting { opacity: 0.3; stroke-dashoffset: 0; }
  .sline-spread-1.is-sprouting,
  .sline-spread-2.is-sprouting { opacity: 0.25; stroke-dashoffset: 0; }
  .sline-bloom-1.is-sprouting,
  .sline-bloom-2.is-sprouting,
  .sline-bloom-3.is-sprouting,
  .sline-bloom-4.is-sprouting,
  .sline-bloom-5.is-sprouting,
  .sline-bloom-6.is-sprouting { opacity: 0.2; stroke-dashoffset: 0; }

  /* Alive = more intense */
  .sline-branch-a.is-alive,
  .sline-branch-b.is-alive { opacity: 0.4; }
  .sline-spread-1.is-alive,
  .sline-spread-2.is-alive { opacity: 0.35; }
  .sline-bloom-1.is-alive,
  .sline-bloom-2.is-alive,
  .sline-bloom-3.is-alive,
  .sline-bloom-4.is-alive,
  .sline-bloom-5.is-alive,
  .sline-bloom-6.is-alive { opacity: 0.3; }

  /* Ink dots — invisible initially, splatter into existence */
  .sdot {
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  .sdot.is-alive { opacity: 0.7; }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .sline-trunk { clip-path: none !important; opacity: 0.2 !important; }
    .sline:not(.sline-trunk) { opacity: 0.15 !important; stroke-dashoffset: 0 !important; }
    .sdot { opacity: 0.5 !important; }
  }

  /* No-JS fallback */
  :global(.no-js) .sline-trunk { clip-path: none; opacity: 0.2; }
  :global(.no-js) .sline:not(.sline-trunk) { opacity: 0.15; stroke-dashoffset: 0; }
  :global(.no-js) .sdot { opacity: 0.5; }

  /* ===== STEPS ===== */
  .storyline-steps {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(6rem, 15vw, 14rem);
    padding: var(--space-2xl) 0;
    max-width: 1100px;
    margin: 0 auto;
  }

  .storyline-step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    max-width: 560px;
    padding: 0 var(--space-md);
  }

  .storyline-step--right { margin-left: auto; margin-right: 5%; }
  .storyline-step--left { margin-left: 5%; margin-right: auto; }

  .storyline-step-badge {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--step-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px color-mix(in srgb, var(--step-accent) 40%, transparent);
    margin-top: var(--space-sm);
  }

  .storyline-step-number {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: var(--text-lg);
    color: white;
  }

  .storyline-step-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .storyline-step-content { flex: 1; }

  .storyline-step-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--step-accent);
    margin-bottom: var(--space-xs);
  }

  .storyline-step-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
    line-height: 1.4;
    letter-spacing: 0.04em;
  }

  .storyline-step-text {
    font-size: var(--text-base);
    line-height: 2;
    color: var(--color-text);
    opacity: 0.8;
  }

  /* Image placeholder */
  .storyline-step-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-sumi-shiro);
    border: 1px solid rgba(26, 26, 46, 0.06);
  }

  .storyline-step-image img { width: 100%; height: 100%; object-fit: cover; }

  .storyline-step-image-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-sm);
    background: linear-gradient(135deg, rgba(26,26,46,0.02), rgba(26,26,46,0.04));
  }

  .storyline-step-image-placeholder svg { width: 80px; height: 80px; opacity: 0.5; }
  .storyline-step-image-hint { font-size: var(--text-xs); color: var(--color-text); opacity: 0.3; font-style: italic; }

  /* Ending */
  .storyline-ending {
    text-align: center;
    padding: var(--space-2xl) var(--space-md) 0;
  }

  .storyline-ending-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 2.2;
    color: var(--color-primary);
  }

  .storyline-ending-text strong {
    color: var(--color-secondary);
    font-size: var(--text-2xl);
    display: block;
    margin-top: var(--space-md);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .storyline-canvas { min-height: auto; }
    .storyline-svg { display: none; }

    .storyline-steps {
      gap: var(--space-xl);
      padding: var(--space-lg) 0;
      border-left: 2px solid rgba(26, 26, 46, 0.1);
      margin-left: var(--space-lg);
      padding-left: var(--space-lg);
    }

    .storyline-step {
      max-width: 100%;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .storyline-step-badge {
      width: 36px; height: 36px;
      margin-left: calc(-1 * var(--space-lg) - 19px);
    }

    .storyline-step-number { font-size: var(--text-sm); }
    .storyline-step-title { font-size: var(--text-xl); }
    .storyline-step-image { aspect-ratio: 16 / 9; }
  }
</style>

<script>
  /**
   * The trunk line draws from top to bottom as user scrolls.
   * When the trunk passes each step's Y position, branches sprout from there.
   * The trunk uses clip-path (inset bottom %) so already-drawn parts stay visible.
   * Branches use stroke-dashoffset CSS transition.
   */
  if (typeof window !== 'undefined') {
    const isMobile = window.innerWidth < 768;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!isMobile && !prefersReducedMotion) {
      const canvas = document.querySelector('.storyline-canvas') as HTMLElement;
      const trunk = document.querySelector('.sline-trunk') as SVGPathElement;
      const dots = document.querySelectorAll('.sdot');

      if (canvas && trunk) {
        // Which branches sprout at each step (cumulative)
        const stepBranches: Record<number, string[]> = {
          1: [],
          2: ['.sline-branch-a'],
          3: ['.sline-branch-b'],
          4: ['.sline-spread-1', '.sline-spread-2'],
          5: ['.sline-bloom-1', '.sline-bloom-2', '.sline-bloom-3',
              '.sline-bloom-4', '.sline-bloom-5', '.sline-bloom-6'],
        };

        // Step thresholds as % of storyline height (approximate Y positions)
        const stepThresholds = [0.15, 0.30, 0.45, 0.60, 0.78];

        const activatedSteps = new Set<number>();

        function updateTrunk() {
          const rect = canvas.getBoundingClientRect();
          const canvasTop = rect.top;
          const canvasHeight = rect.height;
          const viewH = window.innerHeight;

          // How far we've scrolled into the canvas (0 = top just entered, 1 = bottom leaving)
          const scrolledInto = (viewH - canvasTop) / (canvasHeight + viewH);
          const progress = Math.max(0, Math.min(1, scrolledInto));

          // Trunk: reveal from top down using clip-path
          // progress 0 = nothing shown, 1 = fully shown
          // Map progress so trunk starts drawing early and finishes at ~90%
          const trunkProgress = Math.min(1, progress * 1.3);
          const clipBottom = 100 - (trunkProgress * 100);
          trunk.style.clipPath = `inset(0 0 ${clipBottom}% 0)`;

          // Check each step threshold
          stepThresholds.forEach((threshold, i) => {
            const stepNum = i + 1;
            if (progress >= threshold && !activatedSteps.has(stepNum)) {
              activatedSteps.add(stepNum);

              // Dot blooms
              dots[i]?.classList.add('is-alive');

              // Previous step's trunk becomes "alive" (thicker)
              if (stepNum >= 2) {
                trunk.classList.add('is-alive');
              }

              // Sprout new branches for this step
              const newBranches = stepBranches[stepNum] || [];
              newBranches.forEach((sel, j) => {
                const branch = document.querySelector(sel);
                if (branch) {
                  setTimeout(() => {
                    branch.classList.add('is-sprouting');
                    // After sprouting animation, make it "alive" (thicker)
                    setTimeout(() => branch.classList.add('is-alive'), 1500);
                  }, j * 300);
                }
              });

              // Also activate any previous branches that might have been missed (fast scroll)
              for (let s = 1; s < stepNum; s++) {
                (stepBranches[s] || []).forEach(sel => {
                  const b = document.querySelector(sel);
                  b?.classList.add('is-sprouting');
                  b?.classList.add('is-alive');
                });
                dots[s - 1]?.classList.add('is-alive');
              }
            }
          });
        }

        // Run on scroll (throttled via rAF)
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              updateTrunk();
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Initial check
        updateTrunk();
      }
    }
  }
</script>
