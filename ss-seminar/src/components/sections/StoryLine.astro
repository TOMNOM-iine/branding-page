---
/**
 * StoryLine — 居場所からスモールステップで学びへ
 *
 * 線は最初から薄く見えている。スクロールで「生まれる」=太く濃く輝く。
 * 下に行くほど枝分かれが増え、広がり・つながりを表現。
 * 1本 → 2本 → 3本 → 多くの線へ。
 */

const steps = [
  {
    id: 'step-arrive',
    label: 'STEP 1',
    title: 'ここに来る',
    text: 'やる気がなくても大丈夫。ドアは開いている。まずは、ここに来るだけでいい。',
    accent: 'var(--color-you-daidai)',
    side: 'right',
    imageAlt: '教室のドアを開ける子ども',
    imageHint: '教室入口・歓迎の雰囲気',
  },
  {
    id: 'step-belong',
    label: 'STEP 2',
    title: '居場所ができる',
    text: '温かいお茶。「今日どうだった？」。自分のペースでいられる場所。安心が生まれる。',
    accent: 'var(--color-sora-mizu)',
    side: 'left',
    imageAlt: '教室でリラックスする生徒たち',
    imageHint: '温かい教室の雰囲気・笑顔',
  },
  {
    id: 'step-curiosity',
    label: 'STEP 3',
    title: '「なんで？」が芽生える',
    text: '先生が問いかける。「なんでだと思う？」。答えを教えない。自分で考える楽しさに出会う。',
    accent: 'var(--color-tatami-kin)',
    side: 'right',
    imageAlt: '先生と対話する生徒',
    imageHint: 'ソクラテス問答法の対話風景',
  },
  {
    id: 'step-challenge',
    label: 'STEP 4',
    title: '挑戦してみる',
    text: '「ちょっとやってみる？」。小さな一歩。間違えても大丈夫。ここでは誰も笑わない。',
    accent: 'var(--color-you-daidai)',
    side: 'left',
    imageAlt: '問題に取り組む生徒',
    imageHint: '集中して学ぶ姿・ノートに書く',
  },
  {
    id: 'step-grow',
    label: 'STEP 5',
    title: '自分の力で学ぶ',
    text: '「わかった！」の瞬間。自分で考え、自分で見つけた答え。それが一生の力になる。',
    accent: 'var(--color-sora-mizu)',
    side: 'right',
    imageAlt: '達成感を感じる生徒の笑顔',
    imageHint: '笑顔・達成感・自信',
  },
];
---

<section class="storyline" id="storyline" aria-label="居場所から学びへのストーリー">
  <div class="storyline-header appear">
    <p class="storyline-label text-latin">Our Vision</p>
    <h2 class="storyline-title text-display">居場所から、学びへ。</h2>
    <p class="storyline-subtitle">一人ひとりのペースで。スモールステップで。</p>
  </div>

  <div class="storyline-canvas">
    <!-- Full-width SVG — lines ALWAYS visible (thin/faint), become alive on scroll -->
    <svg class="storyline-svg" viewBox="0 0 1200 3200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <!-- Rough brush edge — ink on washi paper -->
        <filter id="ink-rough" x="-10%" y="-10%" width="120%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="5" seed="3" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <!-- Heavier distortion for splatter -->
        <filter id="ink-splatter" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="4" seed="11" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="12" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>

      <!-- ============================================================
           巨大筆書道 — 大字書道スタイル
           全身で書く一筆書き。墨溜まり、かすれ、飛沫。
           ============================================================ -->

      <!-- ====== TRUNK: 幹 — filled path for pressure variation ====== -->
      <!-- The trunk is drawn as a FILLED shape, not a stroked line.
           This allows thick-thin pressure variation along the curve.
           Entry: thick (筆を降ろす). Middle: variable. Exit: thin trail. -->
      <g class="sline sline-trunk" filter="url(#ink-rough)">
        <!-- Main body — thick filled brush stroke shape -->
        <path d="
          M590,0 C588,20 592,50 595,80
          C585,150 540,200 480,280
          Q400,350 360,420 Q330,480 340,530
          Q345,560 370,570 Q410,560 460,530
          Q550,490 640,480 Q750,470 810,510
          Q850,540 830,600 Q800,680 790,730
          Q785,760 790,780 Q810,790 840,780
          Q880,750 900,720 Q910,700 890,750
          Q840,850 720,900 Q580,950 420,980
          Q300,1010 280,1060 Q260,1110 320,1120
          Q360,1130 400,1120 Q500,1090 600,1100
          Q730,1115 820,1160 Q900,1200 870,1280
          Q840,1360 800,1390 Q780,1400 790,1410
          Q830,1400 870,1370 Q900,1340 880,1380
          Q830,1460 720,1490 Q580,1520 440,1560
          Q340,1600 350,1660 Q360,1700 420,1700
          Q520,1690 620,1710 Q740,1740 810,1800
          Q860,1850 830,1920 Q790,1990 720,2040
          Q680,2070 660,2090 Q640,2110 660,2110
          Q700,2100 740,2080 Q780,2050 760,2100
          Q710,2180 620,2230 Q520,2290 470,2370
          Q430,2440 470,2490 Q510,2520 560,2530
          Q610,2530 640,2560 Q650,2600 620,2680
          Q600,2760 590,2850 Q585,2940 590,3000
          L610,3000
          Q615,2940 620,2850 Q630,2760 650,2680
          Q680,2600 670,2560 Q660,2530 640,2520
          Q600,2510 560,2510 Q510,2500 490,2460
          Q470,2420 500,2370 Q550,2290 640,2230
          Q730,2180 780,2100 Q800,2050 770,2080
          Q730,2110 690,2120 Q660,2120 680,2100
          Q700,2070 740,2040 Q810,1990 850,1920
          Q880,1850 840,1800 Q780,1730 660,1700
          Q560,1680 440,1690 Q380,1690 370,1660
          Q360,1620 400,1580 Q480,1540 600,1510
          Q740,1480 850,1450 Q920,1420 910,1380
          Q900,1340 850,1370 Q810,1400 770,1410
          Q750,1420 760,1400 Q780,1370 800,1340
          Q870,1250 840,1180 Q800,1130 700,1110
          Q600,1090 480,1100 Q390,1110 340,1130
          Q280,1150 260,1110 Q240,1060 300,1010
          Q380,960 520,940 Q700,910 820,850
          Q890,800 910,750 Q930,700 900,720
          Q870,750 830,780 Q790,800 770,790
          Q750,770 760,740 Q770,700 780,660
          Q810,580 780,530 Q740,490 650,490
          Q550,500 460,540 Q400,570 360,580
          Q320,590 310,560 Q300,520 320,460
          Q350,380 420,310 Q500,220 560,150
          Q580,100 585,50 Q590,20 595,0
          Z"
          fill="var(--color-primary)"
          opacity="0.55"
        />
        <!-- Ink pooling at pressure points — darker concentrated areas -->
        <ellipse cx="340" cy="540" rx="35" ry="25" fill="var(--color-primary)" opacity="0.15" transform="rotate(-10, 340, 540)" />
        <ellipse cx="800" cy="750" rx="30" ry="22" fill="var(--color-primary)" opacity="0.15" transform="rotate(15, 800, 750)" />
        <ellipse cx="320" cy="1100" rx="38" ry="28" fill="var(--color-primary)" opacity="0.18" transform="rotate(-5, 320, 1100)" />
        <ellipse cx="800" cy="1400" rx="40" ry="30" fill="var(--color-primary)" opacity="0.2" transform="rotate(8, 800, 1400)" />
        <ellipse cx="650" cy="2100" rx="50" ry="35" fill="var(--color-primary)" opacity="0.22" transform="rotate(-3, 650, 2100)" />
      </g>

      <!-- ====== SPLATTER TRAILS — 墨飛沫 at direction changes ====== -->
      <g class="ink-splatters" filter="url(#ink-splatter)">
        <!-- Step 1 area — light spray -->
        <circle cx="310" cy="500" r="8" fill="var(--color-primary)" opacity="0.2" />
        <circle cx="290" cy="520" r="4" fill="var(--color-primary)" opacity="0.15" />
        <circle cx="395" cy="490" r="5" fill="var(--color-primary)" opacity="0.12" />
        <circle cx="280" cy="545" r="3" fill="var(--color-primary)" opacity="0.1" />
        <!-- Step 2 area — medium spray -->
        <circle cx="850" cy="700" r="10" fill="var(--color-primary)" opacity="0.2" />
        <circle cx="870" cy="720" r="6" fill="var(--color-primary)" opacity="0.15" />
        <circle cx="830" cy="690" r="4" fill="var(--color-primary)" opacity="0.12" />
        <circle cx="890" cy="740" r="3" fill="var(--color-primary)" opacity="0.1" />
        <circle cx="760" cy="770" r="5" fill="var(--color-primary)" opacity="0.1" />
        <!-- Step 3 area — heavier spray -->
        <circle cx="260" cy="1060" r="12" fill="var(--color-primary)" opacity="0.22" />
        <circle cx="240" cy="1080" r="7" fill="var(--color-primary)" opacity="0.18" />
        <circle cx="380" cy="1070" r="5" fill="var(--color-primary)" opacity="0.15" />
        <circle cx="250" cy="1120" r="6" fill="var(--color-primary)" opacity="0.12" />
        <circle cx="395" cy="1100" r="4" fill="var(--color-primary)" opacity="0.1" />
        <circle cx="230" cy="1050" r="3" fill="var(--color-primary)" opacity="0.08" />
        <!-- Step 4 area — wild spray -->
        <circle cx="850" cy="1350" r="14" fill="var(--color-primary)" opacity="0.25" />
        <circle cx="870" cy="1370" r="8" fill="var(--color-primary)" opacity="0.2" />
        <circle cx="750" cy="1420" r="6" fill="var(--color-primary)" opacity="0.15" />
        <circle cx="890" cy="1390" r="5" fill="var(--color-primary)" opacity="0.12" />
        <circle cx="720" cy="1380" r="7" fill="var(--color-primary)" opacity="0.1" />
        <circle cx="910" cy="1360" r="4" fill="var(--color-primary)" opacity="0.08" />
        <circle cx="830" cy="1440" r="5" fill="var(--color-primary)" opacity="0.08" />
        <circle cx="700" cy="1400" r="3" fill="var(--color-primary)" opacity="0.06" />
        <!-- Step 5 area — EXPLOSIVE spray 大爆発 -->
        <circle cx="580" cy="2050" r="18" fill="var(--color-primary)" opacity="0.28" />
        <circle cx="620" cy="2040" r="12" fill="var(--color-primary)" opacity="0.22" />
        <circle cx="540" cy="2080" r="10" fill="var(--color-primary)" opacity="0.2" />
        <circle cx="700" cy="2060" r="8" fill="var(--color-primary)" opacity="0.18" />
        <circle cx="500" cy="2100" r="7" fill="var(--color-primary)" opacity="0.15" />
        <circle cx="730" cy="2090" r="6" fill="var(--color-primary)" opacity="0.12" />
        <circle cx="480" cy="2050" r="5" fill="var(--color-primary)" opacity="0.1" />
        <circle cx="750" cy="2120" r="5" fill="var(--color-primary)" opacity="0.1" />
        <circle cx="460" cy="2110" r="4" fill="var(--color-primary)" opacity="0.08" />
        <circle cx="770" cy="2070" r="4" fill="var(--color-primary)" opacity="0.08" />
        <circle cx="520" cy="2130" r="3" fill="var(--color-primary)" opacity="0.06" />
        <circle cx="690" cy="2140" r="3" fill="var(--color-primary)" opacity="0.06" />
      </g>

      <!-- ====== BRANCHES — filled brush shapes (not stroked) ====== -->
      <!-- Branch A: splits from step 2, thick entry thinning out -->
      <path class="sline sline-branch-a" filter="url(#ink-rough)"
        d="M790,740 Q830,750 860,800 Q900,870 880,960 Q860,1050 820,1100
           Q780,1150 750,1200 Q720,1280 730,1380 Q740,1480 720,1560
           Q700,1650 680,1740 Q660,1850 660,1950 Q660,2100 660,2300
           Q660,2500 650,2680
           L660,2680
           Q670,2500 670,2300 Q670,2100 670,1950 Q670,1850 690,1740
           Q710,1650 730,1560 Q750,1480 740,1380 Q730,1280 760,1200
           Q790,1150 830,1100 Q870,1050 890,960 Q910,870 870,800
           Q840,750 800,740 Z"
        fill="var(--color-primary)" opacity="0" />

      <!-- Branch B: splits from step 3 -->
      <path class="sline sline-branch-b" filter="url(#ink-rough)"
        d="M340,1100 Q300,1130 260,1200 Q220,1280 230,1380
           Q240,1500 280,1580 Q320,1660 340,1760 Q360,1880 350,2000
           Q340,2150 360,2300 Q380,2500 400,2700 Q420,2850 440,2900
           L450,2900
           Q430,2850 410,2700 Q390,2500 370,2300 Q350,2150 360,2000
           Q370,1880 350,1760 Q330,1660 290,1580 Q250,1500 240,1380
           Q230,1280 270,1200 Q310,1130 350,1100 Z"
        fill="var(--color-primary)" opacity="0" />

      <!-- ====== SPREADING VEINS — thinner filled shapes ====== -->
      <path class="sline sline-spread-1" filter="url(#ink-rough)"
        d="M730,1480 Q800,1530 870,1620 Q940,1720 960,1850 Q970,2000 940,2150
           Q910,2350 880,2550 Q860,2700 850,2800
           L856,2800
           Q866,2700 886,2550 Q916,2350 946,2150 Q976,2000 966,1850
           Q946,1720 876,1620 Q806,1530 736,1480 Z"
        fill="var(--color-primary)" opacity="0" />
      <path class="sline sline-spread-2" filter="url(#ink-rough)"
        d="M300,1580 Q250,1640 210,1750 Q180,1870 190,2020
           Q200,2200 230,2380 Q260,2560 280,2700 Q290,2850 290,2900
           L296,2900
           Q296,2850 286,2700 Q266,2560 236,2380 Q206,2200 196,2020
           Q186,1870 216,1750 Q256,1640 306,1580 Z"
        fill="var(--color-primary)" opacity="0" />

      <!-- ====== BLOOM VEINS — many thin wild strokes ====== -->
      <path class="sline sline-bloom-1" filter="url(#ink-rough)" d="M640,2100 Q580,2150 500,2250 Q430,2360 380,2500 Q350,2620 340,2780 L345,2780 Q355,2620 385,2500 Q435,2360 505,2250 Q585,2150 645,2100 Z" fill="var(--color-primary)" opacity="0" />
      <path class="sline sline-bloom-2" filter="url(#ink-rough)" d="M680,2100 Q740,2150 820,2250 Q890,2360 920,2500 Q940,2620 950,2800 L955,2800 Q945,2620 925,2500 Q895,2360 825,2250 Q745,2150 685,2100 Z" fill="var(--color-primary)" opacity="0" />
      <path class="sline sline-bloom-3" filter="url(#ink-rough)" d="M480,2400 Q420,2440 350,2530 Q300,2620 280,2750 Q270,2880 270,2980 L275,2980 Q275,2880 285,2750 Q305,2620 355,2530 Q425,2440 485,2400 Z" fill="var(--color-primary)" opacity="0" />
      <path class="sline sline-bloom-4" filter="url(#ink-rough)" d="M720,2400 Q780,2440 850,2530 Q900,2620 920,2750 Q930,2880 930,2980 L935,2980 Q935,2880 925,2750 Q905,2620 855,2530 Q785,2440 725,2400 Z" fill="var(--color-primary)" opacity="0" />
      <path class="sline sline-bloom-5" filter="url(#ink-rough)" d="M530,2600 Q490,2640 440,2720 Q400,2800 390,2900 Q385,2980 390,3050 L395,3050 Q390,2980 395,2900 Q405,2800 445,2720 Q495,2640 535,2600 Z" fill="var(--color-primary)" opacity="0" />
      <path class="sline sline-bloom-6" filter="url(#ink-rough)" d="M680,2600 Q720,2640 770,2720 Q810,2800 820,2900 Q825,2980 820,3050 L825,3050 Q830,2980 825,2900 Q815,2800 775,2720 Q725,2640 685,2600 Z" fill="var(--color-primary)" opacity="0" />

      <!-- ====== INK POOLS at steps — 墨溜まり ====== -->
      <g class="sdot sdot-1" filter="url(#ink-splatter)">
        <ellipse cx="350" cy="545" rx="22" ry="18" fill="var(--color-primary)" transform="rotate(-15, 350, 545)" />
        <circle cx="325" cy="530" r="5" fill="var(--color-primary)" />
        <circle cx="375" cy="555" r="4" fill="var(--color-primary)" />
        <circle cx="340" cy="570" r="3" fill="var(--color-primary)" />
      </g>
      <g class="sdot sdot-2" filter="url(#ink-splatter)">
        <ellipse cx="800" cy="745" rx="25" ry="20" fill="var(--color-primary)" transform="rotate(10, 800, 745)" />
        <circle cx="830" cy="730" r="6" fill="var(--color-primary)" />
        <circle cx="775" cy="760" r="5" fill="var(--color-primary)" />
        <circle cx="820" cy="770" r="3" fill="var(--color-primary)" />
      </g>
      <g class="sdot sdot-3" filter="url(#ink-splatter)">
        <ellipse cx="340" cy="1095" rx="30" ry="24" fill="var(--color-primary)" transform="rotate(-8, 340, 1095)" />
        <circle cx="310" cy="1080" r="7" fill="var(--color-primary)" />
        <circle cx="370" cy="1110" r="6" fill="var(--color-primary)" />
        <circle cx="325" cy="1120" r="4" fill="var(--color-primary)" />
        <circle cx="365" cy="1080" r="3" fill="var(--color-primary)" />
      </g>
      <g class="sdot sdot-4" filter="url(#ink-splatter)">
        <ellipse cx="800" cy="1395" rx="35" ry="28" fill="var(--color-primary)" transform="rotate(12, 800, 1395)" />
        <circle cx="840" cy="1375" r="8" fill="var(--color-primary)" />
        <circle cx="765" cy="1415" r="7" fill="var(--color-primary)" />
        <circle cx="820" cy="1425" r="5" fill="var(--color-primary)" />
        <circle cx="755" cy="1385" r="4" fill="var(--color-primary)" />
        <circle cx="845" cy="1410" r="3" fill="var(--color-primary)" />
      </g>
      <g class="sdot sdot-5" filter="url(#ink-splatter)">
        <ellipse cx="650" cy="2095" rx="45" ry="35" fill="var(--color-primary)" transform="rotate(-5, 650, 2095)" />
        <circle cx="600" cy="2070" r="10" fill="var(--color-primary)" />
        <circle cx="700" cy="2075" r="9" fill="var(--color-primary)" />
        <circle cx="620" cy="2130" r="8" fill="var(--color-primary)" />
        <circle cx="680" cy="2120" r="7" fill="var(--color-primary)" />
        <circle cx="580" cy="2090" r="5" fill="var(--color-primary)" />
        <circle cx="720" cy="2100" r="5" fill="var(--color-primary)" />
        <circle cx="560" cy="2110" r="4" fill="var(--color-primary)" />
        <circle cx="740" cy="2080" r="4" fill="var(--color-primary)" />
      </g>
    </svg>

    <!-- Step cards -->
    <div class="storyline-steps">
      {steps.map((step, i) => (
        <div
          class:list={['storyline-step', `storyline-step--${step.side}`, 'appear']}
          id={step.id}
          data-step={i + 1}
          style={`--step-accent: ${step.accent}`}
        >
          <div class="storyline-step-badge" aria-hidden="true">
            <span class="storyline-step-number">{i + 1}</span>
          </div>
          <div class="storyline-step-body">
            <div class="storyline-step-content">
              <span class="storyline-step-label text-latin">{step.label}</span>
              <h3 class="storyline-step-title">{step.title}</h3>
              <p class="storyline-step-text">{step.text}</p>
            </div>
            <div class="storyline-step-image" data-step={i + 1}>
              <div class="storyline-step-image-placeholder">
                <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
                  <rect x="10" y="18" width="60" height="44" rx="4" stroke="var(--step-accent)" stroke-width="1.5" opacity="0.3" />
                  <circle cx="30" cy="35" r="6" stroke="var(--step-accent)" stroke-width="1" opacity="0.3" />
                  <path d="M10,52 L30,38 L45,48 L55,40 L70,52 L70,62 L10,62 Z" fill="var(--step-accent)" opacity="0.08" />
                </svg>
                <span class="storyline-step-image-hint">{step.imageHint}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="storyline-ending appear">
    <p class="storyline-ending-text">
      この道のりは、一人ひとり違う。<br>
      でも、始まりはいつも同じ——<br>
      <strong>「ここに来てくれて、ありがとう。」</strong>
    </p>
  </div>
</section>

<style>
  .storyline {
    position: relative;
    padding: var(--space-2xl) 0 var(--space-section);
    overflow: hidden;
  }

  .storyline-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    padding: 0 var(--space-md);
  }

  .storyline-label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-sm);
  }

  .storyline-title { font-size: var(--text-3xl); margin-bottom: var(--space-sm); }

  .storyline-subtitle {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
    opacity: 0.6;
  }

  .storyline-canvas {
    position: relative;
    min-height: 200vh;
  }

  .storyline-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* ===== INK SPLATTERS — always visible, part of the ink landscape ===== */
  .ink-splatters {
    opacity: 0;
    transition: opacity 2s var(--ease-out-expo);
  }

  .ink-splatters.is-visible { opacity: 1; }

  /* ===== TRUNK — 巨大筆 filled shape, reveals top to bottom ===== */
  .sline-trunk {
    clip-path: inset(0 0 100% 0);
    transition: none; /* clip-path controlled by JS rAF */
  }

  /* ===== BRANCHES — filled shapes, hidden until sprouting ===== */
  .sline:not(.sline-trunk) {
    transition: opacity 1.5s var(--ease-out-expo);
  }

  .sline-branch-a.is-sprouting,
  .sline-branch-b.is-sprouting { opacity: 0.35 !important; }
  .sline-spread-1.is-sprouting,
  .sline-spread-2.is-sprouting { opacity: 0.25 !important; }
  .sline-bloom-1.is-sprouting,
  .sline-bloom-2.is-sprouting,
  .sline-bloom-3.is-sprouting,
  .sline-bloom-4.is-sprouting,
  .sline-bloom-5.is-sprouting,
  .sline-bloom-6.is-sprouting { opacity: 0.2 !important; }

  /* Alive = fully vivid */
  .sline-branch-a.is-alive,
  .sline-branch-b.is-alive { opacity: 0.45 !important; }
  .sline-spread-1.is-alive,
  .sline-spread-2.is-alive { opacity: 0.35 !important; }
  .sline-bloom-1.is-alive,
  .sline-bloom-2.is-alive,
  .sline-bloom-3.is-alive,
  .sline-bloom-4.is-alive,
  .sline-bloom-5.is-alive,
  .sline-bloom-6.is-alive { opacity: 0.3 !important; }

  /* Ink pools — invisible, then splat into existence */
  .sdot {
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .sdot.is-alive { opacity: 0.65; }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .sline-trunk { clip-path: none !important; }
    .sline:not(.sline-trunk) { opacity: 0.2 !important; }
    .sdot { opacity: 0.4 !important; }
    .ink-splatters { opacity: 1 !important; }
  }

  /* No-JS fallback */
  :global(.no-js) .sline-trunk { clip-path: none; }
  :global(.no-js) .sline:not(.sline-trunk) { opacity: 0.2; }
  :global(.no-js) .sdot { opacity: 0.4; }
  :global(.no-js) .ink-splatters { opacity: 1; }

  /* ===== STEPS ===== */
  .storyline-steps {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(6rem, 15vw, 14rem);
    padding: var(--space-2xl) 0;
    max-width: 1100px;
    margin: 0 auto;
  }

  .storyline-step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    max-width: 560px;
    padding: 0 var(--space-md);
  }

  .storyline-step--right { margin-left: auto; margin-right: 5%; }
  .storyline-step--left { margin-left: 5%; margin-right: auto; }

  .storyline-step-badge {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--step-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px color-mix(in srgb, var(--step-accent) 40%, transparent);
    margin-top: var(--space-sm);
  }

  .storyline-step-number {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: var(--text-lg);
    color: white;
  }

  .storyline-step-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .storyline-step-content { flex: 1; }

  .storyline-step-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--step-accent);
    margin-bottom: var(--space-xs);
  }

  .storyline-step-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
    line-height: 1.4;
    letter-spacing: 0.04em;
  }

  .storyline-step-text {
    font-size: var(--text-base);
    line-height: 2;
    color: var(--color-text);
    opacity: 0.8;
  }

  /* Image placeholder */
  .storyline-step-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-sumi-shiro);
    border: 1px solid rgba(26, 26, 46, 0.06);
  }

  .storyline-step-image img { width: 100%; height: 100%; object-fit: cover; }

  .storyline-step-image-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-sm);
    background: linear-gradient(135deg, rgba(26,26,46,0.02), rgba(26,26,46,0.04));
  }

  .storyline-step-image-placeholder svg { width: 80px; height: 80px; opacity: 0.5; }
  .storyline-step-image-hint { font-size: var(--text-xs); color: var(--color-text); opacity: 0.3; font-style: italic; }

  /* Ending */
  .storyline-ending {
    text-align: center;
    padding: var(--space-2xl) var(--space-md) 0;
  }

  .storyline-ending-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 2.2;
    color: var(--color-primary);
  }

  .storyline-ending-text strong {
    color: var(--color-secondary);
    font-size: var(--text-2xl);
    display: block;
    margin-top: var(--space-md);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .storyline-canvas { min-height: auto; }
    .storyline-svg { display: none; }

    .storyline-steps {
      gap: var(--space-xl);
      padding: var(--space-lg) 0;
      border-left: 2px solid rgba(26, 26, 46, 0.1);
      margin-left: var(--space-lg);
      padding-left: var(--space-lg);
    }

    .storyline-step {
      max-width: 100%;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .storyline-step-badge {
      width: 36px; height: 36px;
      margin-left: calc(-1 * var(--space-lg) - 19px);
    }

    .storyline-step-number { font-size: var(--text-sm); }
    .storyline-step-title { font-size: var(--text-xl); }
    .storyline-step-image { aspect-ratio: 16 / 9; }
  }
</style>

<script>
  /**
   * The trunk line draws from top to bottom as user scrolls.
   * When the trunk passes each step's Y position, branches sprout from there.
   * The trunk uses clip-path (inset bottom %) so already-drawn parts stay visible.
   * Branches use stroke-dashoffset CSS transition.
   */
  if (typeof window !== 'undefined') {
    const isMobile = window.innerWidth < 768;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!isMobile && !prefersReducedMotion) {
      const canvas = document.querySelector('.storyline-canvas') as HTMLElement;
      const trunk = document.querySelector('.sline-trunk') as SVGGElement;
      const dots = document.querySelectorAll('.sdot');
      const splatters = document.querySelector('.ink-splatters');

      if (canvas && trunk) {
        // Which branches sprout at each step (cumulative)
        const stepBranches: Record<number, string[]> = {
          1: [],
          2: ['.sline-branch-a'],
          3: ['.sline-branch-b'],
          4: ['.sline-spread-1', '.sline-spread-2'],
          5: ['.sline-bloom-1', '.sline-bloom-2', '.sline-bloom-3',
              '.sline-bloom-4', '.sline-bloom-5', '.sline-bloom-6'],
        };

        // Step thresholds as % of storyline height (approximate Y positions)
        const stepThresholds = [0.15, 0.30, 0.45, 0.60, 0.78];

        const activatedSteps = new Set<number>();

        function updateTrunk() {
          const rect = canvas.getBoundingClientRect();
          const canvasTop = rect.top;
          const canvasHeight = rect.height;
          const viewH = window.innerHeight;

          // How far we've scrolled into the canvas (0 = top just entered, 1 = bottom leaving)
          const scrolledInto = (viewH - canvasTop) / (canvasHeight + viewH);
          const progress = Math.max(0, Math.min(1, scrolledInto));

          // Show splatters as soon as trunk starts drawing
          if (progress > 0.05 && splatters) {
            splatters.classList.add('is-visible');
          }

          // Trunk: reveal from top down using clip-path
          // progress 0 = nothing shown, 1 = fully shown
          // Map progress so trunk starts drawing early and finishes at ~90%
          const trunkProgress = Math.min(1, progress * 1.3);
          const clipBottom = 100 - (trunkProgress * 100);
          trunk.style.clipPath = `inset(0 0 ${clipBottom}% 0)`;

          // Check each step threshold
          stepThresholds.forEach((threshold, i) => {
            const stepNum = i + 1;
            if (progress >= threshold && !activatedSteps.has(stepNum)) {
              activatedSteps.add(stepNum);

              // Dot blooms
              dots[i]?.classList.add('is-alive');

              // Previous step's trunk becomes "alive" (thicker)
              if (stepNum >= 2) {
                trunk.classList.add('is-alive');
              }

              // Sprout new branches for this step
              const newBranches = stepBranches[stepNum] || [];
              newBranches.forEach((sel, j) => {
                const branch = document.querySelector(sel);
                if (branch) {
                  setTimeout(() => {
                    branch.classList.add('is-sprouting');
                    // After sprouting animation, make it "alive" (thicker)
                    setTimeout(() => branch.classList.add('is-alive'), 1500);
                  }, j * 300);
                }
              });

              // Also activate any previous branches that might have been missed (fast scroll)
              for (let s = 1; s < stepNum; s++) {
                (stepBranches[s] || []).forEach(sel => {
                  const b = document.querySelector(sel);
                  b?.classList.add('is-sprouting');
                  b?.classList.add('is-alive');
                });
                dots[s - 1]?.classList.add('is-alive');
              }
            }
          });
        }

        // Run on scroll (throttled via rAF)
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              updateTrunk();
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Initial check
        updateTrunk();
      }
    }
  }
</script>
