---
---

<section class="scene flex items-center justify-center bg-gradient-to-b from-[var(--color-bg)] to-[#E7F5FF]" id="scene-campus">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-center text-[var(--color-primary-dark)] mb-4 scene-fade">
      校舎紹介
    </h2>
    <p class="text-center text-[var(--color-text-secondary)] mb-16 scene-fade">
      栃木県日光市に2つの教室
    </p>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Imaichi Campus -->
      <div class="campus-card">
        <div class="card overflow-hidden group">
          <!-- Illustration header -->
          <div class="h-48 bg-gradient-to-br from-[var(--color-primary)]/10 to-[var(--color-tertiary)]/10 flex items-center justify-center relative overflow-hidden">
            <svg viewBox="0 0 300 160" width="300" height="160">
              <!-- Simple building -->
              <rect x="60" y="40" width="180" height="100" fill="white" rx="6" stroke="#E0E0E0"/>
              <polygon points="60,40 150,5 240,40" fill="#4DABF7" opacity="0.8"/>
              <!-- Windows -->
              <rect x="80" y="60" width="35" height="30" fill="#E7F5FF" rx="3" stroke="#4DABF7"/>
              <rect x="132" y="60" width="35" height="30" fill="#E7F5FF" rx="3" stroke="#4DABF7"/>
              <rect x="185" y="60" width="35" height="30" fill="#E7F5FF" rx="3" stroke="#4DABF7"/>
              <!-- Door -->
              <rect x="128" y="100" width="44" height="40" fill="#FF8A80" rx="4"/>
              <circle cx="164" cy="122" r="3" fill="#FFD43B"/>
              <!-- Sign -->
              <rect x="112" y="28" width="76" height="12" fill="#FFD43B" rx="3"/>
              <text x="150" y="37" text-anchor="middle" font-size="7" fill="#1971C2" font-weight="bold">今市校舎</text>
              <!-- Tree -->
              <rect x="20" y="90" width="8" height="40" fill="#8B6914" rx="2"/>
              <circle cx="24" cy="75" r="20" fill="#69DB7C" opacity="0.7"/>
              <circle cx="260" cy="95" r="18" fill="#51CF66" opacity="0.6"/>
              <rect x="256" y="105" width="8" height="30" fill="#8B6914" rx="2"/>
            </svg>
            <div class="absolute top-3 right-3 bg-[var(--color-primary)] text-white text-xs px-3 py-1 rounded-full font-bold">
              今市
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl text-[var(--color-primary-dark)] mb-2">今市校舎</h3>
            <p class="text-sm text-[var(--color-text-secondary)] mb-4 leading-relaxed">
              日光市の中心部に位置する本校。小学生から高校生まで、幅広い学年の生徒が通う活気ある校舎です。
            </p>
            <div class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)]">
              <span>📍</span>
              <span>栃木県日光市</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Nikko Campus -->
      <div class="campus-card">
        <div class="card overflow-hidden group">
          <div class="h-48 bg-gradient-to-br from-[var(--color-accent-purple)]/10 to-[var(--color-secondary)]/10 flex items-center justify-center relative overflow-hidden">
            <svg viewBox="0 0 300 160" width="300" height="160">
              <rect x="60" y="40" width="180" height="100" fill="white" rx="6" stroke="#E0E0E0"/>
              <polygon points="60,40 150,5 240,40" fill="#B197FC" opacity="0.8"/>
              <rect x="80" y="60" width="35" height="30" fill="#F3EDFF" rx="3" stroke="#B197FC"/>
              <rect x="132" y="60" width="35" height="30" fill="#F3EDFF" rx="3" stroke="#B197FC"/>
              <rect x="185" y="60" width="35" height="30" fill="#F3EDFF" rx="3" stroke="#B197FC"/>
              <rect x="128" y="100" width="44" height="40" fill="#FF8A80" rx="4"/>
              <circle cx="164" cy="122" r="3" fill="#FFD43B"/>
              <rect x="112" y="28" width="76" height="12" fill="#FFD43B" rx="3"/>
              <text x="150" y="37" text-anchor="middle" font-size="7" fill="#1971C2" font-weight="bold">日光校舎</text>
              <rect x="20" y="90" width="8" height="40" fill="#8B6914" rx="2"/>
              <circle cx="24" cy="75" r="20" fill="#69DB7C" opacity="0.7"/>
              <circle cx="260" cy="95" r="18" fill="#51CF66" opacity="0.6"/>
              <rect x="256" y="105" width="8" height="30" fill="#8B6914" rx="2"/>
              <!-- Mountains in background for Nikko -->
              <polygon points="0,50 40,15 80,50" fill="#69DB7C" opacity="0.2"/>
              <polygon points="220,50 270,10 300,45" fill="#69DB7C" opacity="0.15"/>
            </svg>
            <div class="absolute top-3 right-3 bg-[var(--color-accent-purple)] text-white text-xs px-3 py-1 rounded-full font-bold">
              日光
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl text-[var(--color-primary-dark)] mb-2">日光校舎</h3>
            <p class="text-sm text-[var(--color-text-secondary)] mb-4 leading-relaxed">
              自然豊かな日光エリアの校舎。落ち着いた環境で、一人ひとりに寄り添ったきめ細かな指導を行います。
            </p>
            <div class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)]">
              <span>📍</span>
              <span>栃木県日光市</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-10 scene-fade">
      <a href="/campus" class="btn-secondary">
        校舎の詳細を見る →
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('#scene-campus .scene-fade').forEach((el: any) => {
    gsap.from(el, {
      opacity: 0, y: 30, duration: 0.6,
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' }
    });
  });

  gsap.utils.toArray('.campus-card').forEach((el: any, i: number) => {
    gsap.from(el, {
      opacity: 0, y: 50, duration: 0.7, delay: i * 0.2,
      scrollTrigger: { trigger: '#scene-campus', start: 'top 50%', toggleActions: 'play none none reverse' }
    });
  });
</script>
