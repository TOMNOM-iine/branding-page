---
---

<section class="scene flex items-center justify-center" style="background: linear-gradient(to bottom, #F8F9FF, #E7F5FF);" id="scene-hero">
  <!-- Clouds -->
  <svg class="absolute top-[8%] left-[5%] opacity-60" width="120" height="50" viewBox="0 0 120 50" style="animation: float-cloud 8s ease-in-out infinite">
    <ellipse cx="60" cy="30" rx="55" ry="18" fill="white"/>
    <ellipse cx="40" cy="22" rx="30" ry="16" fill="white"/>
    <ellipse cx="80" cy="24" rx="28" ry="14" fill="white"/>
  </svg>
  <svg class="absolute top-[12%] right-[10%] opacity-40" width="100" height="40" viewBox="0 0 100 40" style="animation: float-cloud-slow 10s ease-in-out infinite">
    <ellipse cx="50" cy="22" rx="45" ry="15" fill="white"/>
    <ellipse cx="30" cy="16" rx="25" ry="12" fill="white"/>
    <ellipse cx="70" cy="18" rx="24" ry="11" fill="white"/>
  </svg>
  <svg class="absolute top-[20%] left-[40%] opacity-30" width="80" height="35" viewBox="0 0 80 35" style="animation: float-cloud 12s ease-in-out infinite 2s">
    <ellipse cx="40" cy="20" rx="35" ry="12" fill="white"/>
    <ellipse cx="25" cy="14" rx="20" ry="10" fill="white"/>
  </svg>

  <!-- School building illustration -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1200 400" class="w-full" preserveAspectRatio="xMidYMax meet">
      <!-- Ground -->
      <rect x="0" y="320" width="1200" height="80" fill="#69DB7C" opacity="0.3" rx="0"/>
      <rect x="0" y="340" width="1200" height="60" fill="#69DB7C" opacity="0.2"/>

      <!-- Trees -->
      <g transform="translate(80, 200)">
        <rect x="20" y="60" width="12" height="60" fill="#8B6914" rx="3"/>
        <circle cx="26" cy="40" r="35" fill="#69DB7C" opacity="0.8"/>
        <circle cx="10" cy="50" r="25" fill="#51CF66" opacity="0.7"/>
        <circle cx="40" cy="48" r="22" fill="#40C057" opacity="0.6"/>
      </g>
      <g transform="translate(1020, 220)">
        <rect x="18" y="50" width="10" height="50" fill="#8B6914" rx="3"/>
        <circle cx="23" cy="32" r="30" fill="#69DB7C" opacity="0.7"/>
        <circle cx="8" cy="42" r="20" fill="#51CF66" opacity="0.6"/>
      </g>

      <!-- School building -->
      <g transform="translate(350, 120)">
        <!-- Main building -->
        <rect x="0" y="60" width="500" height="200" fill="#FFFFFF" rx="8" stroke="#E0E0E0" stroke-width="1"/>
        <!-- Roof -->
        <polygon points="0,60 250,-20 500,60" fill="#4DABF7" opacity="0.9"/>
        <!-- Clock -->
        <circle cx="250" cy="20" r="22" fill="white" stroke="#4DABF7" stroke-width="2"/>
        <line x1="250" y1="20" x2="250" y2="8" stroke="#1971C2" stroke-width="2" stroke-linecap="round"/>
        <line x1="250" y1="20" x2="260" y2="20" stroke="#1971C2" stroke-width="2" stroke-linecap="round"/>
        <!-- Windows row 1 -->
        <rect x="30" y="90" width="60" height="50" fill="#E7F5FF" rx="4" stroke="#4DABF7" stroke-width="1"/>
        <rect x="110" y="90" width="60" height="50" fill="#E7F5FF" rx="4" stroke="#4DABF7" stroke-width="1"/>
        <rect x="330" y="90" width="60" height="50" fill="#E7F5FF" rx="4" stroke="#4DABF7" stroke-width="1"/>
        <rect x="410" y="90" width="60" height="50" fill="#E7F5FF" rx="4" stroke="#4DABF7" stroke-width="1"/>
        <!-- Door -->
        <rect x="210" y="160" width="80" height="100" fill="#FF8A80" rx="6"/>
        <circle cx="275" cy="215" r="5" fill="#FFD43B"/>
        <!-- Windows in door -->
        <rect x="225" y="172" width="50" height="30" fill="#FFE0DB" rx="3"/>
        <!-- Sign -->
        <rect x="195" y="70" width="110" height="18" fill="#FFD43B" rx="4"/>
        <text x="250" y="83" text-anchor="middle" font-size="10" fill="#1971C2" font-weight="bold" font-family="sans-serif">S&Sセミナー</text>
      </g>

      <!-- Children walking toward school -->
      <!-- Child 1 -->
      <g transform="translate(200, 260)" class="child-walk" style="animation: gentle-bounce 2s ease-in-out infinite">
        <circle cx="10" cy="0" r="10" fill="#FFD43B"/>
        <rect x="4" y="10" width="12" height="20" fill="#4DABF7" rx="3"/>
        <rect x="0" y="30" width="8" height="14" fill="#495057" rx="2"/>
        <rect x="12" y="30" width="8" height="14" fill="#495057" rx="2"/>
        <rect x="14" y="6" width="12" height="16" fill="#FF8A80" rx="3" transform="rotate(15, 14, 6)"/>
      </g>
      <!-- Child 2 -->
      <g transform="translate(260, 265)" style="animation: gentle-bounce 2s ease-in-out infinite 0.3s">
        <circle cx="10" cy="0" r="9" fill="#8B6914"/>
        <rect x="4" y="9" width="12" height="18" fill="#FF8A80" rx="3"/>
        <rect x="1" y="27" width="7" height="13" fill="#495057" rx="2"/>
        <rect x="12" y="27" width="7" height="13" fill="#495057" rx="2"/>
      </g>
      <!-- Child 3 -->
      <g transform="translate(310, 258)" style="animation: gentle-bounce 2s ease-in-out infinite 0.6s">
        <circle cx="10" cy="0" r="11" fill="#495057"/>
        <rect x="3" y="11" width="14" height="22" fill="#69DB7C" rx="3"/>
        <rect x="0" y="33" width="8" height="15" fill="#495057" rx="2"/>
        <rect x="12" y="33" width="8" height="15" fill="#495057" rx="2"/>
        <rect x="15" y="8" width="14" height="18" fill="#B197FC" rx="3" transform="rotate(-10, 15, 8)"/>
      </g>

      <!-- Flowers -->
      <circle cx="150" cy="335" r="6" fill="#FF8A80" opacity="0.7"/>
      <circle cx="180" cy="340" r="5" fill="#FFD43B" opacity="0.6"/>
      <circle cx="950" cy="338" r="6" fill="#B197FC" opacity="0.6"/>
      <circle cx="980" cy="332" r="5" fill="#FF8A80" opacity="0.5"/>
    </svg>
  </div>

  <!-- Main content -->
  <div class="relative z-10 text-center px-4 pb-40 md:pb-32">
    <div class="mb-4">
      <span class="inline-block bg-white/80 backdrop-blur-sm text-[var(--color-text-secondary)] text-sm px-4 py-1.5 rounded-full shadow-sm">
        栃木県日光市 ・ 40年以上の歴史
      </span>
    </div>

    <h1 id="hero-title" class="text-[var(--color-primary-dark)] mb-4 opacity-0">
      勉強以前の<br class="sm:hidden">居場所から始まる学び
    </h1>

    <p id="hero-subtitle" class="font-fun text-[var(--color-text-secondary)] text-lg md:text-xl mb-8 opacity-0">
      どんな子にも、まず笑顔の居場所を。
    </p>

    <div id="hero-ctas" class="flex flex-col sm:flex-row gap-4 justify-center items-center opacity-0">
      <a href="#scene-door" class="btn-primary text-lg">
        冒険を始めよう!
      </a>
      <a href="/contact" class="btn-secondary text-lg">
        お問い合わせ
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2" style="animation: gentle-bounce 2s ease-in-out infinite">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Hero entrance animation
  const tl = gsap.timeline({ delay: 0.3 });
  tl.to('#hero-title', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' })
    .to('#hero-subtitle', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
    .to('#hero-ctas', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.2');

  // Set initial states
  gsap.set('#hero-title', { y: 30 });
  gsap.set('#hero-subtitle', { y: 20 });
  gsap.set('#hero-ctas', { y: 20 });
</script>
