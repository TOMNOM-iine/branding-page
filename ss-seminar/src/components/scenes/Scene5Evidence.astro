---
---

<section class="scene flex items-center justify-center bg-[var(--color-bg)]" id="scene-evidence">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-center text-[var(--color-primary-dark)] mb-4 scene-fade">
      エビデンスの庭
    </h2>
    <p class="text-center text-[var(--color-text-secondary)] mb-6 scene-fade">
      科学的根拠に基づく、子どもを丸ごと包み込む支援
    </p>
    <p class="text-center text-sm text-[var(--color-text-secondary)] mb-16 scene-fade font-fun">
      それぞれの島をタップして詳しく見てみよう
    </p>

    <!-- Support Islands -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 mb-16">
      <!-- Island 1: Academic -->
      <div class="island-card group cursor-pointer" data-island="academic">
        <div class="card text-center p-6 border-2 border-transparent hover:border-[var(--color-primary)] transition-all">
          <div class="w-16 h-16 mx-auto mb-3 bg-[var(--color-primary)]/10 rounded-full flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            📚
          </div>
          <h4 class="text-sm font-bold text-[var(--color-primary-dark)]">学習支援</h4>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">ソクラテス問答法による<br>対話型の学び</p>
        </div>
      </div>

      <!-- Island 2: Mentoring -->
      <div class="island-card group cursor-pointer" data-island="mentoring">
        <div class="card text-center p-6 border-2 border-transparent hover:border-[var(--color-secondary)] transition-all">
          <div class="w-16 h-16 mx-auto mb-3 bg-[var(--color-secondary)]/10 rounded-full flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            🤝
          </div>
          <h4 class="text-sm font-bold text-[var(--color-primary-dark)]">メンタリング</h4>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">一人ひとりに寄り添う<br>メンター制度</p>
        </div>
      </div>

      <!-- Island 3: School Continuation -->
      <div class="island-card group cursor-pointer" data-island="continuation">
        <div class="card text-center p-6 border-2 border-transparent hover:border-[var(--color-tertiary)] transition-all">
          <div class="w-16 h-16 mx-auto mb-3 bg-[var(--color-tertiary)]/10 rounded-full flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            🏫
          </div>
          <h4 class="text-sm font-bold text-[var(--color-primary-dark)]">就学継続支援</h4>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">中退リスクの早期察知と<br>介入サポート</p>
        </div>
      </div>

      <!-- Island 4: Learning Difficulty -->
      <div class="island-card group cursor-pointer" data-island="difficulty">
        <div class="card text-center p-6 border-2 border-transparent hover:border-[var(--color-accent)] transition-all">
          <div class="w-16 h-16 mx-auto mb-3 bg-[var(--color-accent)]/10 rounded-full flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            💪
          </div>
          <h4 class="text-sm font-bold text-[var(--color-primary-dark)]">学習困難支援</h4>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">エビデンスベースの<br>個別対応プログラム</p>
        </div>
      </div>

      <!-- Island 5: Community -->
      <div class="island-card group cursor-pointer col-span-2 md:col-span-1" data-island="community">
        <div class="card text-center p-6 border-2 border-transparent hover:border-[var(--color-accent-purple)] transition-all">
          <div class="w-16 h-16 mx-auto mb-3 bg-[var(--color-accent-purple)]/10 rounded-full flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
            🏡
          </div>
          <h4 class="text-sm font-bold text-[var(--color-primary-dark)]">コミュニティ</h4>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">第三の居場所としての<br>安心できる空間</p>
        </div>
      </div>
    </div>

    <!-- Bridge connections (visual) -->
    <div class="hidden md:block relative max-w-4xl mx-auto mb-12">
      <svg viewBox="0 0 800 60" class="w-full opacity-30">
        <path d="M80,30 Q200,5 320,30" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-dasharray="8,4"/>
        <path d="M320,30 Q440,5 560,30" stroke="var(--color-secondary)" stroke-width="2" fill="none" stroke-dasharray="8,4"/>
        <path d="M160,30 Q400,55 640,30" stroke="var(--color-tertiary)" stroke-width="2" fill="none" stroke-dasharray="8,4"/>
      </svg>
    </div>

    <!-- Evidence summary -->
    <div class="max-w-3xl mx-auto scene-fade">
      <div class="card bg-gradient-to-r from-[var(--color-primary)]/5 to-[var(--color-accent-purple)]/5 border border-[var(--color-primary)]/10">
        <div class="text-center">
          <h3 class="text-[var(--color-primary-dark)] mb-3">子どもを丸ごと包摂する</h3>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed max-w-xl mx-auto">
            S&Sセミナーは、学力向上だけを目指す塾ではありません。
            子どもが抱える困難を丸ごと受け止め、居場所→信頼関係→学習意欲→成長という
            エビデンスに基づいた自然な導線で、一人ひとりの可能性を引き出します。
          </p>
          <a href="/evidence" class="btn-primary mt-6 !text-sm">
            詳しいエビデンスを見る →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('#scene-evidence .scene-fade').forEach((el: any) => {
    gsap.from(el, {
      opacity: 0, y: 30, duration: 0.6,
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' }
    });
  });

  gsap.utils.toArray('.island-card').forEach((el: any, i: number) => {
    gsap.from(el, {
      opacity: 0, y: 40, scale: 0.9, duration: 0.5, delay: i * 0.1,
      scrollTrigger: { trigger: '#scene-evidence', start: 'top 50%', toggleActions: 'play none none reverse' }
    });
  });
</script>
