---
---

<section class="scene flex items-center justify-center bg-gradient-to-b from-[var(--color-bg)] to-[#FFF7E6]" id="scene-smiles">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-center text-[var(--color-primary-dark)] mb-4 scene-fade">
      笑顔が生まれる
    </h2>
    <p class="text-center text-[var(--color-text-secondary)] mb-16 scene-fade font-fun text-lg">
      ソクラテス問答法 × 40年以上の歴史
    </p>

    <!-- Socratic dialogue illustration -->
    <div class="relative max-w-3xl mx-auto mb-16">
      <!-- Children at desks -->
      <div class="flex justify-center gap-8 md:gap-16 mb-8">
        <!-- Teacher -->
        <div class="text-center scene-fade">
          <div class="w-20 h-20 md:w-24 md:h-24 bg-[var(--color-primary)] rounded-full flex items-center justify-center text-3xl md:text-4xl shadow-lg">
            👩‍🏫
          </div>
          <p class="text-sm mt-2 text-[var(--color-text-secondary)]">先生</p>
        </div>
        <!-- Student 1 -->
        <div class="text-center scene-fade">
          <div class="w-20 h-20 md:w-24 md:h-24 bg-[var(--color-accent)] rounded-full flex items-center justify-center text-3xl md:text-4xl shadow-lg">
            👦
          </div>
          <p class="text-sm mt-2 text-[var(--color-text-secondary)]">生徒A</p>
        </div>
        <!-- Student 2 -->
        <div class="text-center scene-fade">
          <div class="w-20 h-20 md:w-24 md:h-24 bg-[var(--color-secondary)] rounded-full flex items-center justify-center text-3xl md:text-4xl shadow-lg">
            👧
          </div>
          <p class="text-sm mt-2 text-[var(--color-text-secondary)]">生徒B</p>
        </div>
      </div>

      <!-- Speech bubbles - Socratic dialogue -->
      <div class="space-y-4 max-w-lg mx-auto">
        <div class="speech-bubble flex items-start gap-3 opacity-0" data-bubble="1">
          <span class="shrink-0 text-xl mt-1">👩‍🏫</span>
          <div class="bg-[var(--color-primary)]/10 border border-[var(--color-primary)]/20 rounded-2xl rounded-tl-sm px-4 py-3">
            <p class="text-sm text-[var(--color-text-primary)]">「なぜ、そう思ったの？」</p>
          </div>
        </div>
        <div class="speech-bubble flex items-start gap-3 justify-end opacity-0" data-bubble="2">
          <div class="bg-[var(--color-accent)]/15 border border-[var(--color-accent)]/20 rounded-2xl rounded-tr-sm px-4 py-3">
            <p class="text-sm text-[var(--color-text-primary)]">「うーん…なんとなく？」</p>
          </div>
          <span class="shrink-0 text-xl mt-1">👦</span>
        </div>
        <div class="speech-bubble flex items-start gap-3 opacity-0" data-bubble="3">
          <span class="shrink-0 text-xl mt-1">👩‍🏫</span>
          <div class="bg-[var(--color-primary)]/10 border border-[var(--color-primary)]/20 rounded-2xl rounded-tl-sm px-4 py-3">
            <p class="text-sm text-[var(--color-text-primary)]">「じゃあ、こう考えたらどうかな？」</p>
          </div>
        </div>
        <div class="speech-bubble flex items-start gap-3 justify-end opacity-0" data-bubble="4">
          <div class="bg-[var(--color-secondary)]/15 border border-[var(--color-secondary)]/20 rounded-2xl rounded-tr-sm px-4 py-3">
            <p class="text-sm text-[var(--color-text-primary)]">「あ！わかった！そういうことか！」</p>
          </div>
          <span class="shrink-0 text-xl mt-1">👧</span>
        </div>
      </div>
    </div>

    <!-- Counter stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 max-w-4xl mx-auto mb-12">
      <div class="card text-center scene-fade">
        <div class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] font-fun counter" data-target="40">0</div>
        <div class="text-sm text-[var(--color-text-secondary)] mt-1">年以上の歴史</div>
      </div>
      <div class="card text-center scene-fade">
        <div class="text-3xl md:text-4xl font-bold text-[var(--color-secondary)] font-fun">対話</div>
        <div class="text-sm text-[var(--color-text-secondary)] mt-1">ソクラテス問答法</div>
      </div>
      <div class="card text-center scene-fade">
        <div class="text-3xl md:text-4xl font-bold text-[var(--color-tertiary)] font-fun">2</div>
        <div class="text-sm text-[var(--color-text-secondary)] mt-1">校舎（今市・日光）</div>
      </div>
      <div class="card text-center scene-fade">
        <div class="text-3xl md:text-4xl font-bold text-[var(--color-accent-purple)] font-fun">全員</div>
        <div class="text-sm text-[var(--color-text-secondary)] mt-1">どんな子にも</div>
      </div>
    </div>

    <!-- Testimonial -->
    <div class="max-w-2xl mx-auto scene-fade">
      <div class="card border-l-4 border-[var(--color-primary)]">
        <p class="text-[var(--color-text-primary)] italic mb-3 leading-relaxed">
          「最初は塾なんて絶対嫌だと言っていた息子が、今では自分から『今日S&S行く日？』と聞いてくるようになりました。」
        </p>
        <div class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)]">
          <span class="text-xl">👩</span>
          <span>中学2年生の保護者</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Fade in elements
  gsap.utils.toArray('#scene-smiles .scene-fade').forEach((el: any, i: number) => {
    gsap.from(el, {
      opacity: 0,
      y: 30,
      duration: 0.6,
      delay: i * 0.1,
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none reverse',
      }
    });
  });

  // Speech bubbles pop in sequentially
  gsap.utils.toArray('.speech-bubble').forEach((el: any, i: number) => {
    gsap.to(el, {
      opacity: 1,
      x: 0,
      duration: 0.5,
      delay: i * 0.3,
      scrollTrigger: {
        trigger: '#scene-smiles',
        start: 'top 40%',
        toggleActions: 'play none none reverse',
      }
    });
    gsap.set(el, { x: i % 2 === 0 ? -20 : 20 });
  });

  // Counter animation
  gsap.utils.toArray('.counter').forEach((el: any) => {
    const target = parseInt(el.dataset.target);
    if (isNaN(target)) return;
    ScrollTrigger.create({
      trigger: el,
      start: 'top 80%',
      onEnter: () => {
        gsap.to(el, {
          innerText: target,
          duration: 1.5,
          snap: { innerText: 1 },
          ease: 'power2.out',
        });
      },
      once: true,
    });
  });
</script>
