---
/**
 * HeroCanvas — SVG-based animated hero
 * Geometric zones with hand-drawn line art that sketches itself in.
 * Tagline appears character by character.
 * Background cycles through palette colors.
 */
---

<section class="hero" id="hero" aria-label="S&Sセミナーへようこそ">
  <div class="hero-bg" aria-hidden="true"></div>

  <!-- Geometric SVG Canvas -->
  <div class="hero-canvas" aria-hidden="true">
    <svg class="hero-svg" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" fill="none">
      <!-- Geometric zone dividers -->
      <path class="geo-line geo-line-1" d="M400,0 L380,400 L420,800" stroke="#E8D44D" stroke-width="2" />
      <path class="geo-line geo-line-2" d="M750,0 L780,350 L720,800" stroke="#4ECDC4" stroke-width="2" />
      <path class="geo-line geo-line-3" d="M0,300 L600,280 L1200,320" stroke="#FF6B35" stroke-width="1.5" />
      <path class="geo-line geo-line-4" d="M0,550 L500,580 L1200,530" stroke="#1A1A2E" stroke-width="1.5" />

      <!-- ====== CENTRAL CHILD (main character, large) ====== -->
      <g class="hero-illustration" transform="translate(520, 180)">
        <!-- Head -->
        <circle class="draw-element" cx="60" cy="40" r="32" stroke="#1A1A2E" stroke-width="2.5" />
        <!-- Hair (messy, expressive — Yuasa style) -->
        <path class="draw-element draw-delay-1" d="M32,28 Q28,15 40,12 Q55,8 65,10 Q80,12 88,20 Q92,25 88,30" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <!-- Happy eyes (arc style) -->
        <path class="draw-element draw-delay-1" d="M46,35 Q50,29 54,35" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <path class="draw-element draw-delay-1" d="M66,35 Q70,29 74,35" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <!-- Big warm smile -->
        <path class="draw-element draw-delay-2" d="M45,50 Q60,62 75,50" stroke="#FF6B35" stroke-width="2.5" stroke-linecap="round" />
        <!-- Blush marks -->
        <circle class="draw-element draw-delay-2" cx="40" cy="45" r="4" fill="#FF6B35" opacity="0.12" />
        <circle class="draw-element draw-delay-2" cx="80" cy="45" r="4" fill="#FF6B35" opacity="0.12" />
        <!-- Body -->
        <path class="draw-element draw-delay-2" d="M60,72 L60,150" stroke="#1A1A2E" stroke-width="2.5" stroke-linecap="round" />
        <!-- Arms reaching out wide (welcoming) -->
        <path class="draw-element draw-delay-3" d="M60,100 Q30,80 10,75" stroke="#1A1A2E" stroke-width="2.5" stroke-linecap="round" />
        <path class="draw-element draw-delay-3" d="M60,100 Q90,80 110,75" stroke="#1A1A2E" stroke-width="2.5" stroke-linecap="round" />
        <!-- Open hands -->
        <path class="draw-element draw-delay-3" d="M10,75 L5,70 M10,75 L5,78 M10,75 L12,68" stroke="#1A1A2E" stroke-width="1.5" stroke-linecap="round" />
        <path class="draw-element draw-delay-3" d="M110,75 L115,70 M110,75 L115,78 M110,75 L108,68" stroke="#1A1A2E" stroke-width="1.5" stroke-linecap="round" />
        <!-- Legs -->
        <path class="draw-element draw-delay-3" d="M60,150 L35,200" stroke="#1A1A2E" stroke-width="2.5" stroke-linecap="round" />
        <path class="draw-element draw-delay-3" d="M60,150 L85,200" stroke="#1A1A2E" stroke-width="2.5" stroke-linecap="round" />
      </g>

      <!-- ====== SECOND CHILD (left, smaller, shy but smiling) ====== -->
      <g class="hero-illustration" transform="translate(200, 320)">
        <circle class="draw-element draw-delay-3" cx="25" cy="15" r="18" stroke="#1A1A2E" stroke-width="2" />
        <!-- Shy eyes -->
        <circle class="draw-element draw-delay-4" cx="20" cy="12" r="2.5" fill="#1A1A2E" />
        <circle class="draw-element draw-delay-4" cx="32" cy="12" r="2.5" fill="#1A1A2E" />
        <!-- Small smile -->
        <path class="draw-element draw-delay-4" d="M19,20 Q25,25 31,20" stroke="#4ECDC4" stroke-width="1.5" stroke-linecap="round" />
        <!-- Body (sitting) -->
        <path class="draw-element draw-delay-4" d="M25,33 L25,65" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <path class="draw-element draw-delay-5" d="M25,45 L10,55" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <path class="draw-element draw-delay-5" d="M25,45 L40,38" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <!-- Holding a book -->
        <rect class="draw-element draw-delay-5" x="35" y="32" width="16" height="12" rx="1" stroke="#4ECDC4" stroke-width="1.5" />
        <path class="draw-element draw-delay-5" d="M43,32 L43,44" stroke="#4ECDC4" stroke-width="1" />
        <!-- Legs (sitting cross-legged) -->
        <path class="draw-element draw-delay-5" d="M25,65 Q15,75 10,70" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <path class="draw-element draw-delay-5" d="M25,65 Q35,75 40,70" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
      </g>

      <!-- ====== THIRD CHILD (right, energetic, running) ====== -->
      <g class="hero-illustration" transform="translate(880, 280)">
        <circle class="draw-element draw-delay-4" cx="20" cy="12" r="16" stroke="#1A1A2E" stroke-width="2" />
        <!-- Excited eyes -->
        <path class="draw-element draw-delay-5" d="M14,9 L14,6" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <path class="draw-element draw-delay-5" d="M26,9 L26,6" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <!-- Wide open smile -->
        <path class="draw-element draw-delay-5" d="M12,17 Q20,25 28,17" stroke="#E8D44D" stroke-width="2" stroke-linecap="round" />
        <!-- Body (dynamic running pose) -->
        <path class="draw-element draw-delay-5" d="M20,28 L20,70" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <!-- Arms (one forward, one back — running) -->
        <path class="draw-element draw-delay-5" d="M20,42 L-5,35" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <path class="draw-element draw-delay-5" d="M20,42 L40,50" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <!-- Legs (running stride) -->
        <path class="draw-element draw-delay-6" d="M20,70 L2,95" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <path class="draw-element draw-delay-6" d="M20,70 L38,88" stroke="#1A1A2E" stroke-width="2" stroke-linecap="round" />
        <!-- Motion lines -->
        <path class="draw-element draw-delay-6" d="M-10,40 L-20,40" stroke="#E8D44D" stroke-width="1" stroke-linecap="round" opacity="0.5" />
        <path class="draw-element draw-delay-6" d="M-8,50 L-22,50" stroke="#E8D44D" stroke-width="1" stroke-linecap="round" opacity="0.4" />
        <path class="draw-element draw-delay-6" d="M-6,60 L-18,60" stroke="#E8D44D" stroke-width="1" stroke-linecap="round" opacity="0.3" />
      </g>

      <!-- ====== DESK/TABLE (larger, more detailed) ====== -->
      <g class="hero-illustration" transform="translate(430, 400)">
        <!-- Table top -->
        <path class="draw-element draw-delay-4" d="M0,15 Q160,5 320,15" stroke="#E8D44D" stroke-width="3" stroke-linecap="round" />
        <!-- Table legs -->
        <path class="draw-element draw-delay-4" d="M30,15 L25,85" stroke="#E8D44D" stroke-width="2.5" stroke-linecap="round" />
        <path class="draw-element draw-delay-4" d="M290,15 L295,85" stroke="#E8D44D" stroke-width="2.5" stroke-linecap="round" />
        <!-- Open book on desk -->
        <g class="draw-element draw-delay-5" transform="translate(100, -10)">
          <path d="M0,20 Q30,5 60,0 Q90,5 120,20" stroke="#4ECDC4" stroke-width="2" stroke-linecap="round" />
          <path d="M60,0 L60,20" stroke="#4ECDC4" stroke-width="1.5" />
          <!-- Text lines on pages -->
          <path d="M10,10 L50,6" stroke="#4ECDC4" stroke-width="0.8" opacity="0.4" />
          <path d="M12,14 L48,10" stroke="#4ECDC4" stroke-width="0.8" opacity="0.3" />
          <path d="M70,6 L110,10" stroke="#4ECDC4" stroke-width="0.8" opacity="0.4" />
          <path d="M72,10 L108,14" stroke="#4ECDC4" stroke-width="0.8" opacity="0.3" />
        </g>
        <!-- Pencil -->
        <g class="draw-element draw-delay-5" transform="translate(250, -5) rotate(-20)">
          <rect x="0" y="0" width="40" height="6" rx="1" stroke="#FF6B35" stroke-width="1.5" />
          <path d="M40,0 L48,3 L40,6" stroke="#FF6B35" stroke-width="1.5" fill="none" />
        </g>
        <!-- Notebook stack -->
        <g class="draw-element draw-delay-5" transform="translate(30, -15)">
          <rect x="0" y="0" width="35" height="25" rx="2" stroke="#1A1A2E" stroke-width="1.5" opacity="0.4" />
          <rect x="3" y="-3" width="35" height="25" rx="2" stroke="#1A1A2E" stroke-width="1.5" opacity="0.3" />
        </g>
      </g>

      <!-- ====== PLANT (organic, growing — symbolizing growth) ====== -->
      <g class="hero-illustration" transform="translate(120, 430)">
        <!-- Pot -->
        <path class="draw-element draw-delay-5" d="M15,60 L5,90 L55,90 L45,60 Z" stroke="#C1292E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <!-- Stem -->
        <path class="draw-element draw-delay-5" d="M30,60 Q28,35 35,20" stroke="#4ECDC4" stroke-width="2" stroke-linecap="round" />
        <!-- Leaves (organic curves) -->
        <path class="draw-element draw-delay-6" d="M30,45 Q15,35 20,25 Q25,35 30,45" stroke="#4ECDC4" stroke-width="1.5" stroke-linecap="round" fill="#4ECDC4" fill-opacity="0.1" />
        <path class="draw-element draw-delay-6" d="M33,35 Q48,25 43,15 Q38,25 33,35" stroke="#4ECDC4" stroke-width="1.5" stroke-linecap="round" fill="#4ECDC4" fill-opacity="0.1" />
        <path class="draw-element draw-delay-6" d="M35,20 Q45,10 40,2 Q35,10 35,20" stroke="#4ECDC4" stroke-width="1.5" stroke-linecap="round" fill="#4ECDC4" fill-opacity="0.08" />
      </g>

      <!-- ====== SCATTERED BOOKS (right side) ====== -->
      <g class="hero-illustration" transform="translate(950, 480)">
        <rect class="draw-element draw-delay-5" x="0" y="0" width="45" height="8" rx="1" stroke="#FF6B35" stroke-width="1.5" transform="rotate(-8)" />
        <rect class="draw-element draw-delay-5" x="10" y="-5" width="40" height="8" rx="1" stroke="#4ECDC4" stroke-width="1.5" transform="rotate(5)" />
        <rect class="draw-element draw-delay-6" x="5" y="-10" width="42" height="8" rx="1" stroke="#E8D44D" stroke-width="1.5" transform="rotate(-3)" />
      </g>

      <!-- ====== WARMTH CURVES (flowing, organic) ====== -->
      <path class="draw-element draw-delay-5 warmth-curve" d="M80,620 Q200,560 400,580 Q600,600 750,550 Q900,500 1050,540 Q1120,560 1150,530" stroke="#FF6B35" stroke-width="2" stroke-linecap="round" opacity="0.3" />
      <path class="draw-element draw-delay-6 warmth-curve" d="M50,670 Q180,620 380,650 Q580,680 750,630 Q920,580 1080,620 Q1140,640 1180,610" stroke="#E8D44D" stroke-width="1.5" stroke-linecap="round" opacity="0.2" />
      <path class="draw-element draw-delay-6 warmth-curve" d="M0,720 Q250,690 500,710 Q700,730 950,695 Q1100,670 1200,690" stroke="#4ECDC4" stroke-width="1" stroke-linecap="round" opacity="0.15" />

      <!-- ====== FLOATING GEOMETRIC ACCENTS ====== -->
      <!-- Circles -->
      <circle class="geo-accent geo-float-1" cx="100" cy="130" r="10" fill="#4ECDC4" opacity="0.25" />
      <circle class="geo-accent geo-float-2" cx="1080" cy="180" r="7" fill="#FF6B35" opacity="0.2" />
      <circle class="geo-accent geo-float-4" cx="330" cy="250" r="5" fill="#E8D44D" opacity="0.3" />
      <circle class="geo-accent geo-float-3" cx="780" cy="600" r="8" fill="#C1292E" opacity="0.15" />
      <!-- Diamonds -->
      <rect class="geo-accent geo-float-2" x="950" y="130" width="14" height="14" fill="#E8D44D" opacity="0.25" transform="rotate(45, 957, 137)" />
      <rect class="geo-accent geo-float-1" x="170" y="600" width="10" height="10" fill="#4ECDC4" opacity="0.2" transform="rotate(45, 175, 605)" />
      <!-- Triangles -->
      <polygon class="geo-accent geo-float-3" points="1080,430 1094,458 1066,458" fill="#FF6B35" opacity="0.2" />
      <polygon class="geo-accent geo-float-4" points="80,350 90,370 70,370" fill="#E8D44D" opacity="0.25" />
      <!-- Small stars -->
      <g class="geo-accent geo-float-1" transform="translate(300, 120)">
        <path d="M6,0 L7.5,4 L12,5 L8.5,8 L9,12 L6,10 L3,12 L3.5,8 L0,5 L4.5,4 Z" fill="#FF6B35" opacity="0.2" />
      </g>
      <g class="geo-accent geo-float-3" transform="translate(850, 150)">
        <path d="M5,0 L6.5,3.5 L10,4 L7.5,6.5 L8,10 L5,8.5 L2,10 L2.5,6.5 L0,4 L3.5,3.5 Z" fill="#4ECDC4" opacity="0.25" />
      </g>
    </svg>
  </div>

  <!-- Text content -->
  <div class="hero-content">
    <h1 class="hero-tagline">
      <span class="hero-char" style="--i:0">居</span>
      <span class="hero-char" style="--i:1">場</span>
      <span class="hero-char" style="--i:2">所</span>
      <span class="hero-char" style="--i:3">か</span>
      <span class="hero-char" style="--i:4">ら</span>
      <span class="hero-char hero-break" style="--i:5">始</span>
      <span class="hero-char" style="--i:6">ま</span>
      <span class="hero-char" style="--i:7">る</span>
      <span class="hero-char" style="--i:8">学</span>
      <span class="hero-char" style="--i:9">び</span>
    </h1>
    <p class="hero-subtitle">
      やる気がなくても、大丈夫。<br>
      まずは、ここに。
    </p>
    <a href="#philosophy" class="hero-cta">
      まずは、ここに来てみて
    </a>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll-indicator" aria-hidden="true">
    <span class="hero-scroll-line"></span>
    <span class="hero-scroll-text text-latin">scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Cycling background color */
  .hero-bg {
    position: absolute;
    inset: 0;
    animation: color-cycle 30s ease-in-out infinite;
    z-index: 0;
  }

  /* SVG canvas */
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-svg {
    width: 100%;
    height: 100%;
  }

  /* Geometric lines — smooth stroke drawing */
  .geo-line {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: draw-line 3s var(--ease-out-quart, cubic-bezier(0.25, 1, 0.5, 1)) forwards;
  }

  .geo-line-1 { animation-delay: 0.5s; }
  .geo-line-2 { animation-delay: 0.8s; }
  .geo-line-3 { animation-delay: 1.1s; }
  .geo-line-4 { animation-delay: 1.4s; }

  /* Illustration drawing — slower, more organic */
  .draw-element {
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
    animation: draw-line 2.5s var(--ease-out-quart, cubic-bezier(0.25, 1, 0.5, 1)) forwards;
    fill: none;
  }

  .draw-delay-1 { animation-delay: 1.5s; }
  .draw-delay-2 { animation-delay: 1.9s; }
  .draw-delay-3 { animation-delay: 2.3s; }
  .draw-delay-4 { animation-delay: 2.7s; }
  .draw-delay-5 { animation-delay: 3.1s; }
  .draw-delay-6 { animation-delay: 3.5s; }

  /* Floating accents — slower, more gentle */
  .geo-accent {
    animation: zone-float 6s ease-in-out infinite;
  }

  .geo-float-1 { animation-delay: 0s; }
  .geo-float-2 { animation-delay: 1s; }
  .geo-float-3 { animation-delay: 2s; }
  .geo-float-4 { animation-delay: 3s; }

  /* Text content */
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: var(--space-lg);
  }

  /* Tagline — character by character appearance */
  .hero-tagline {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 400;
    color: var(--color-primary);
    letter-spacing: 0.08em;
    line-height: 1.3;
    margin-bottom: var(--space-lg);
  }

  .hero-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(16px) translateZ(0);
    will-change: opacity, transform;
    animation: fade-in-up 1s var(--ease-out-quart, cubic-bezier(0.25, 1, 0.5, 1)) forwards;
    animation-delay: calc(1.2s + var(--i) * 0.15s);
  }

  .hero-break {
    margin-left: 0;
  }

  .hero-subtitle {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text);
    opacity: 0;
    animation: fade-in-up 1.2s var(--ease-smooth, cubic-bezier(0.22, 0.61, 0.36, 1)) forwards;
    animation-delay: 3s;
    margin-bottom: var(--space-xl);
    line-height: 1.8;
  }

  /* CTA button — skewed, pulsing */
  .hero-cta {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-sumi-shiro);
    background: var(--color-secondary);
    padding: var(--space-sm) var(--space-xl);
    border-radius: var(--radius-md);
    transform: rotate(3deg);
    animation: pulse-gentle 3s ease-in-out infinite;
    animation-delay: 3s;
    opacity: 0;
    box-shadow: 0 4px 20px rgba(255, 107, 53, 0.3);
    transition: all var(--duration-fast) var(--ease-out-expo);
  }

  .hero-cta {
    animation: fade-in-up 1.2s var(--ease-smooth, cubic-bezier(0.22, 0.61, 0.36, 1)) forwards, pulse-gentle 4s ease-in-out infinite;
    animation-delay: 3.5s, 5s;
  }

  .hero-cta:hover {
    transform: rotate(3deg) scale(1.05);
    box-shadow: 0 6px 30px rgba(255, 107, 53, 0.4);
    color: var(--color-sumi-shiro);
  }

  /* Scroll indicator */
  .hero-scroll-indicator {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    opacity: 0;
    animation: fade-in 1s ease forwards;
    animation-delay: 3.5s;
  }

  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: var(--color-primary);
    opacity: 0.3;
    animation: scroll-bounce 2s ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: scaleY(1); opacity: 0.3; }
    50% { transform: scaleY(0.5); opacity: 0.1; }
  }

  .hero-scroll-text {
    font-size: var(--text-xs);
    color: var(--color-text);
    opacity: 0.4;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  /* === Mobile === */
  @media (max-width: 768px) {
    .hero-tagline {
      letter-spacing: 0.04em;
    }

    .hero-break::before {
      content: '\A';
      white-space: pre;
    }

    .hero-subtitle br {
      display: none;
    }

    .hero-cta {
      font-size: var(--text-sm);
      padding: var(--space-sm) var(--space-lg);
    }

    /* Simplify SVG on mobile */
    .geo-line-3,
    .geo-line-4,
    .warmth-curve,
    .geo-accent {
      display: none;
    }
  }
</style>
