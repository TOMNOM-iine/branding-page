---
import BaseLayout from '../layouts/BaseLayout.astro';

const businesses = [
  {
    name: 'S&Sセミナー',
    category: '学習塾',
    tagline: '居場所から始まる学び',
    description: 'ソクラテス問答法による個別指導。40年以上の歴史。学習意欲がない子どもも包摂し、居場所提供から学びへの導線をつくる。',
    features: ['ソクラテス問答法', '個別指導', 'Lepton英語', '受験対策', 'オンライン授業'],
    locations: [
      { name: '日光教室（本校）', address: '日光市相生町20-9', phone: '0288-53-2623' },
      { name: '今市教室', address: '日光市今市703', phone: '0288-21-4222' },
    ],
    color: 'var(--color-you-daidai)',
    icon: 'book',
    link: '/',
  },
  {
    name: 'トム・ソーヤ',
    category: '放課後等デイサービス',
    tagline: '好きなことを見つけ、伸ばす',
    description: '養護・ケア・療育の三つの支援。まず安心できる居場所を提供し、リラックスした環境でお子さんの「好き」「やりたい」を見つけ伸ばす。SS式学習支援、コーチング、アナログゲーム療育。',
    features: ['SS式学習支援', 'コーチング', 'アナログゲーム療育', '個別支援計画', '保護者相談'],
    locations: [
      { name: 'トム・ソーヤ', address: '日光市今市703', phone: '0288-25-3000' },
    ],
    color: 'var(--color-sora-mizu)',
    icon: 'adventure',
    link: 'https://www.tom-soya.com/',
  },
  {
    name: 'トム・ソーヤ②',
    category: '放課後等デイサービス',
    tagline: '一人ひとりのペースで',
    description: '2020年2月開設。トム・ソーヤの理念を受け継ぎ、より多くの子どもたちに居場所と成長の機会を提供する第2の拠点。',
    features: ['放課後等デイサービス', 'エビデンスベース支援', 'メンター制度'],
    locations: [
      { name: 'トム・ソーヤ②', address: '日光市今市春日町622-2', phone: '' },
    ],
    color: 'var(--color-tatami-kin)',
    icon: 'adventure2',
    link: '',
  },
  {
    name: '日光AI食堂',
    category: '子ども食堂 × テクノロジー',
    tagline: 'AIと遊びと世代間交流',
    description: '従来の子ども食堂にAI・最新テクノロジー体験を融合。生成AI、VR体験、300種以上のボードゲーム、マーダーミステリー、TRPGなど。地域格差なく最新技術に触れる機会を提供。',
    features: ['AI体験ワークショップ', 'VR体験', 'ボードゲーム300種+', '食事提供', '世代間交流'],
    locations: [
      { name: '日光AI食堂', address: '日光市野口422-12', phone: '' },
    ],
    color: '#8B5CF6',
    icon: 'ai',
    link: '',
    schedule: '第2・4土曜日 12:00〜18:00 / 18歳以下無料',
  },
  {
    name: '大沢児童クラブ ノアノア',
    category: '放課後児童クラブ',
    tagline: '放課後の安心な居場所',
    description: '大沢地区の児童を対象とした放課後児童クラブ。安全で温かい環境の中で、遊び・学び・仲間づくりを支援。',
    features: ['放課後児童クラブ', '安全な居場所', '遊びと学び'],
    locations: [
      { name: 'ノアノア', address: '日光市大沢地区', phone: '' },
    ],
    color: 'var(--color-shu-aka)',
    icon: 'house',
    link: '',
  },
  {
    name: '南原児童クラブ',
    category: '放課後児童クラブ',
    tagline: '地域の子どもを見守る',
    description: '南原地区の児童を対象とした放課後児童クラブ。学校が終わった後、保護者のお迎えまでの安心な居場所を提供。',
    features: ['放課後児童クラブ', '地域連携', '安心な放課後'],
    locations: [
      { name: '南原児童クラブ', address: '日光市南原地区', phone: '' },
    ],
    color: '#059669',
    icon: 'community',
    link: '',
  },
];
---

<BaseLayout
  title="S&S合同会社 グループ事業 — 子どもの未来をまるごと支える"
  description="S&S合同会社は学習塾S&Sセミナー、放課後デイサービス トム・ソーヤ、日光AI食堂、児童クラブなど、日光市で子どもと地域を支える6つの事業を展開しています。"
>
  <section class="group-page">
    <div class="container">
      <!-- Header -->
      <div class="group-header appear">
        <p class="group-label text-latin">S&S LLC Group</p>
        <h1 class="group-title">子どもの未来を<br>まるごと支える</h1>
        <p class="group-subtitle">
          S&S合同会社は、栃木県日光市を拠点に<br>
          学習塾・放課後デイサービス・子ども食堂・児童クラブを運営。<br>
          <strong>教育・福祉・テクノロジー・食</strong>の力で、子どもたちの成長を包括的に支えます。
        </p>
      </div>

      <!-- Philosophy Banner -->
      <div class="group-philosophy appear appear-delay-1">
        <svg class="group-philosophy-bg" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0,100 Q300,30 600,100 Q900,170 1200,100 L1200,200 L0,200 Z" fill="var(--color-primary)" opacity="0.03" />
        </svg>
        <div class="group-philosophy-content">
          <blockquote class="group-quote">
            学習塾から放課後デイ、子ども食堂、児童クラブまで——<br>
            子どもの「居場所」と「成長」を、あらゆる角度から支える。
          </blockquote>
        </div>
      </div>

      <!-- Ecosystem Diagram -->
      <div class="ecosystem appear appear-delay-2">
        <div class="ecosystem-center">
          <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
            <circle cx="60" cy="60" r="50" stroke="var(--color-primary)" stroke-width="2" stroke-dasharray="6 4" opacity="0.2" />
            <circle cx="60" cy="60" r="30" stroke="var(--color-secondary)" stroke-width="2" opacity="0.3" />
            <circle cx="60" cy="45" r="10" stroke="var(--color-primary)" stroke-width="2" />
            <path d="M55,42 Q57,39 59,42" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
            <path d="M61,42 Q63,39 65,42" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
            <path d="M56,48 Q60,52 64,48" stroke="var(--color-you-daidai)" stroke-width="1.5" stroke-linecap="round" />
            <path d="M60,55 L60,75" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" />
            <path d="M60,63 L48,58" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
            <path d="M60,63 L72,58" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span class="ecosystem-label">子ども</span>
        </div>
      </div>

      <!-- Business Cards -->
      <div class="group-grid">
        {businesses.map((biz, i) => (
          <article class:list={['group-card', 'appear', `appear-delay-${(i % 4) + 1}`]} style={`--card-accent: ${biz.color}`}>
            <div class="group-card-header">
              <span class="group-card-category">{biz.category}</span>
              <h2 class="group-card-name">{biz.name}</h2>
              <p class="group-card-tagline">{biz.tagline}</p>
            </div>
            <div class="group-card-body">
              <p class="group-card-desc">{biz.description}</p>
              <ul class="group-card-features">
                {biz.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              {biz.schedule && (
                <p class="group-card-schedule">{biz.schedule}</p>
              )}
              {biz.locations.map((loc) => (
                <div class="group-card-location">
                  <p class="group-card-address">{loc.address}</p>
                  {loc.phone && <a href={`tel:${loc.phone}`} class="group-card-phone">{loc.phone}</a>}
                </div>
              ))}
            </div>
            {biz.link && (
              <a href={biz.link} class="group-card-link" target={biz.link.startsWith('http') ? '_blank' : undefined} rel={biz.link.startsWith('http') ? 'noopener noreferrer' : undefined}>
                詳しく見る →
              </a>
            )}
          </article>
        ))}
      </div>

      <!-- CTA -->
      <div class="group-cta appear">
        <p class="group-cta-text">S&S合同会社の各事業に関するお問い合わせ</p>
        <div class="group-cta-buttons">
          <a href="/#access" class="group-cta-btn group-cta-btn--primary">お問い合わせ</a>
          <a href="/trial" class="group-cta-btn group-cta-btn--secondary">体験申し込み</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .group-page {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-2xl);
  }

  /* Header */
  .group-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .group-label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: var(--space-md);
  }

  .group-title {
    font-size: var(--text-3xl);
    line-height: 1.3;
    margin-bottom: var(--space-lg);
  }

  .group-subtitle {
    font-size: var(--text-base);
    line-height: 2;
    color: var(--color-text);
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
  }

  .group-subtitle strong {
    color: var(--color-secondary);
    font-weight: 700;
  }

  /* Philosophy Banner */
  .group-philosophy {
    position: relative;
    margin-bottom: var(--space-2xl);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .group-philosophy-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .group-philosophy-content {
    position: relative;
    text-align: center;
  }

  .group-quote {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: normal;
    line-height: 2;
    color: var(--color-primary);
    border: none;
    padding: 0;
    margin: 0;
  }

  /* Ecosystem */
  .ecosystem {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
  }

  .ecosystem-center {
    text-align: center;
  }

  .ecosystem-center svg {
    width: 120px;
    height: 120px;
    margin-bottom: var(--space-sm);
  }

  .ecosystem-label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--color-primary);
    font-weight: 800;
  }

  /* Grid */
  .group-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .group-card {
    display: flex;
    flex-direction: column;
    background: var(--color-sumi-shiro);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-fast) var(--ease-out-expo), box-shadow var(--duration-fast) var(--ease-out-expo);
  }

  .group-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .group-card-header {
    padding: var(--space-lg) var(--space-lg) var(--space-md);
    border-bottom: 3px solid var(--card-accent);
  }

  .group-card-category {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--card-accent);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .group-card-name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
    line-height: 1.3;
  }

  .group-card-tagline {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--color-text);
    opacity: 0.7;
  }

  .group-card-body {
    flex: 1;
    padding: var(--space-md) var(--space-lg);
  }

  .group-card-desc {
    font-size: var(--text-sm);
    line-height: 1.8;
    margin-bottom: var(--space-md);
    opacity: 0.85;
  }

  .group-card-features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .group-card-features li {
    font-size: var(--text-xs);
    padding: 2px 10px;
    background: var(--color-accent-soft);
    border-radius: 50px;
    color: var(--color-primary);
    font-weight: 500;
  }

  .group-card-schedule {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--card-accent);
    padding: var(--space-xs) var(--space-sm);
    background: rgba(0,0,0,0.03);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-md);
  }

  .group-card-location {
    font-size: var(--text-xs);
    color: var(--color-text);
    opacity: 0.7;
    margin-bottom: var(--space-xs);
  }

  .group-card-phone {
    font-weight: 700;
    color: var(--card-accent);
  }

  .group-card-link {
    display: block;
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--card-accent);
    border-top: 1px solid rgba(0,0,0,0.05);
    transition: background var(--duration-fast);
  }

  .group-card-link:hover {
    background: rgba(0,0,0,0.02);
    color: var(--card-accent);
  }

  /* CTA */
  .group-cta {
    text-align: center;
    padding: var(--space-2xl) 0;
    border-top: 1px solid rgba(26, 26, 46, 0.08);
  }

  .group-cta-text {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin-bottom: var(--space-lg);
    color: var(--color-primary);
  }

  .group-cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
  }

  .group-cta-btn {
    font-weight: 700;
    font-size: var(--text-base);
    padding: var(--space-sm) var(--space-xl);
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out-expo);
  }

  .group-cta-btn--primary {
    background: var(--color-secondary);
    color: var(--color-sumi-shiro);
  }

  .group-cta-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(255, 107, 53, 0.3);
    color: var(--color-sumi-shiro);
  }

  .group-cta-btn--secondary {
    background: var(--color-primary);
    color: var(--color-sumi-shiro);
  }

  .group-cta-btn--secondary:hover {
    transform: translateY(-2px);
    color: var(--color-sumi-shiro);
  }

  @media (max-width: 768px) {
    .group-grid {
      grid-template-columns: 1fr;
    }

    .group-title {
      font-size: var(--text-2xl);
    }

    .group-subtitle br {
      display: none;
    }

    .group-cta-buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
