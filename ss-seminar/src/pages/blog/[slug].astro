---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — S&Sセミナー`}
  description={post.data.description}
>
  <article class="blog-post">
    <div class="container content-narrow">
      <header class="blog-post-header appear">
        <a href="/blog" class="blog-back">&larr; ブログ一覧に戻る</a>
        <div class="blog-post-meta">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span class="blog-post-category">{post.data.category}</span>
        </div>
        <h1>{post.data.title}</h1>
      </header>

      <div class="blog-post-content appear appear-delay-1">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  @import '../../styles/global.css';
</style>

<style>
  .blog-post {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-2xl);
  }

  .blog-back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text);
    opacity: 0.6;
    margin-bottom: var(--space-lg);
    transition: opacity var(--duration-fast);
  }

  .blog-back:hover {
    opacity: 1;
    color: var(--color-secondary);
  }

  .blog-post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .blog-post-meta time {
    font-family: var(--font-latin);
    font-size: var(--text-xs);
    opacity: 0.6;
  }

  .blog-post-category {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 50px;
    background: var(--color-accent-soft);
    color: var(--color-primary);
  }

  .blog-post-header h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-xl);
  }

  .blog-post-content {
    line-height: 2;
  }

  .blog-post-content :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .blog-post-content :global(h3) {
    font-size: var(--text-lg);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .blog-post-content :global(p) {
    margin-bottom: var(--space-md);
  }

  .blog-post-content :global(ul),
  .blog-post-content :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .blog-post-content :global(li) {
    margin-bottom: var(--space-xs);
  }

  .blog-post-content :global(ul) {
    list-style: disc;
  }

  .blog-post-content :global(ol) {
    list-style: decimal;
  }
</style>
