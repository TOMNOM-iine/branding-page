---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="ブログ — S&Sセミナー" description="S&Sセミナーからのお知らせ、子育てコラム、イベント情報">
  <section class="blog-page">
    <div class="container">
      <div class="blog-header appear">
        <h1 class="heading-offgrid">ブログ</h1>
        <p class="section-subtitle">お知らせ・子育てコラム・イベント情報</p>
      </div>

      <div class="blog-list">
        {posts.map((post) => (
          <article class="blog-card appear">
            <a href={`/blog/${post.id}`} class="blog-card-link">
              <div class="blog-card-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span class="blog-card-category">{post.data.category}</span>
              </div>
              <h2 class="blog-card-title">{post.data.title}</h2>
              <p class="blog-card-desc">{post.data.description}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @import '../../styles/global.css';
</style>

<style>
  .blog-page {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-2xl);
    min-height: 100vh;
  }

  .blog-header {
    margin-bottom: var(--space-2xl);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: var(--content-width);
  }

  .blog-card {
    border-bottom: 1px solid rgba(26, 26, 46, 0.08);
    padding-bottom: var(--space-lg);
  }

  .blog-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .blog-card-link:hover .blog-card-title {
    color: var(--color-secondary);
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .blog-card-meta time {
    font-family: var(--font-latin);
    font-size: var(--text-xs);
    color: var(--color-text);
    opacity: 0.6;
  }

  .blog-card-category {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 50px;
    background: var(--color-accent-soft);
    color: var(--color-primary);
  }

  .blog-card-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
    transition: color var(--duration-fast);
  }

  .blog-card-desc {
    font-size: var(--text-sm);
    opacity: 0.7;
    line-height: 1.6;
  }
</style>
