---
import BaseLayout from '../layouts/BaseLayout.astro';

const topSchools = [
  '宇都宮高校', '東京理科大学', '法政大学', '金沢大学',
  '鹿沼高校', '独協医科大学', '栃木女子高校', '国際医療福祉大学',
];

const punches = [
  { number: '90', unit: '%', message: '記憶定着率', sub: '問答法は「聞くだけ」の18倍' },
  { number: '30', unit: '年', message: '実証済み', sub: '関東15塾の塾長が認めたメソッド' },
  { number: '48', unit: 'h', message: '無料テスト補習/年', sub: '3週間前から毎週末。上がるまで。' },
  { number: '全校', unit: '', message: '訪問調査済み', sub: '県内の私立・公立・通信校すべて' },
];

const allAchievements = {
  national: ['金沢大学', '群馬県立女子大学', '高知県立大学', '新潟県立大学', '会津大学', '長岡技術科学大学'],
  privateUni: ['東京理科大学', '法政大学', '昭和女子大学', '国際医療福祉大学', '独協医科大学', 'フェリス女学院', '帝京大学'],
  publicHigh: ['宇都宮高校', '栃木女子高校', '栃木高校', '宇都宮中央高校', '鹿沼高校', '鹿沼東高校', '宇都宮白楊', '小山工業高等専門学校'],
};
---

<BaseLayout title="ADVANCE — 学習超特急 | S&Sセミナー" description="居場所の先にある全速力の世界。SSメソッドで難関校合格。">
<div class="adv">

  <!-- ===== 1. HERO ===== -->
  <section class="adv-hero">
    <div class="adv-hero-content">
      <span class="adv-badge adv-reveal" data-d="0">ADVANCE</span>
      <h1 class="adv-title adv-reveal" data-d="1">居場所の、<br>その先。</h1>
      <p class="adv-sub adv-reveal" data-d="2">安心が生まれたら、<br>次は全速力だ。</p>
    </div>
  </section>

  <!-- ===== 2. IMPACT: 1校ずつドーンと ===== -->
  <section class="adv-impact">
    <div class="adv-impact-intro adv-reveal" data-d="0">
      <span class="adv-impact-label">TRACK RECORD</span>
      <p class="adv-impact-lead">ここから、ここまで行った。</p>
    </div>
    <div class="adv-impact-reel" id="impact-reel">
      {topSchools.map((school, i) => (
        <div class="adv-impact-slide" data-index={i}>
          <span class="adv-impact-school">{school}</span>
          <span class="adv-impact-tag">合格</span>
        </div>
      ))}
    </div>
    <div class="adv-impact-close adv-reveal" data-d="0">
      <p class="adv-impact-all">全員、ここから始まった。</p>
    </div>
  </section>

  <!-- ===== 3. PUNCH: 数字で殴る ===== -->
  <section class="adv-punches">
    {punches.map((p, i) => (
      <div class="adv-punch adv-reveal" data-d={i}>
        <span class="adv-punch-num">{p.number}<span class="adv-punch-unit">{p.unit}</span></span>
        <div>
          <h2 class="adv-punch-msg">{p.message}</h2>
          <p class="adv-punch-sub">{p.sub}</p>
        </div>
      </div>
    ))}
  </section>

  <!-- ===== 4. METHOD ===== -->
  <section class="adv-method">
    <span class="adv-label adv-reveal" data-d="0">THE METHOD</span>
    <h2 class="adv-section-title adv-reveal" data-d="0">SSメソッド</h2>
    <p class="adv-section-sub adv-reveal" data-d="0">答えは教えない。問いかけで、引き出す。</p>

    <div class="adv-method-grid">
      <div class="adv-mcard adv-reveal" data-d="0">
        <span class="adv-mcard-num">01</span>
        <h3>問答法</h3>
        <p>質問で解のプロセスを生徒から引き出す。受動→能動。定着率18倍。</p>
      </div>
      <div class="adv-mcard adv-reveal" data-d="1">
        <span class="adv-mcard-num">02</span>
        <h3>24h学習アクセス</h3>
        <p>全授業を録画アーカイブ。導入動画、要約、宿題。いつでもどこでも。</p>
      </div>
      <div class="adv-mcard adv-reveal" data-d="2">
        <span class="adv-mcard-num">03</span>
        <h3>教材10種+</h3>
        <p>問答法に最適化。暗記最小化。2-4-7法則で長期記憶へ。</p>
      </div>
      <div class="adv-mcard adv-reveal" data-d="3">
        <span class="adv-mcard-num">04</span>
        <h3>SS式進路指導</h3>
        <p>県内全校訪問済み。元作新学院進路指導が常勤。ミスマッチを防ぐ。</p>
      </div>
    </div>
  </section>

  <!-- ===== 5. PYRAMID ===== -->
  <section class="adv-pyramid">
    <h2 class="adv-section-title adv-reveal" data-d="0">なぜ、問答法か。</h2>
    <div class="adv-pbars" id="pyramid">
      <div class="adv-pb" data-d="0"><span class="adv-pb-fill" style="width:5%;background:#333"></span><span class="adv-pb-lbl">聞くだけ <b>5%</b></span></div>
      <div class="adv-pb" data-d="1"><span class="adv-pb-fill" style="width:11%;background:#444"></span><span class="adv-pb-lbl">読む <b>10%</b></span></div>
      <div class="adv-pb" data-d="2"><span class="adv-pb-fill" style="width:22%;background:#555"></span><span class="adv-pb-lbl">視聴覚 <b>20%</b></span></div>
      <div class="adv-pb" data-d="3"><span class="adv-pb-fill" style="width:33%;background:#666"></span><span class="adv-pb-lbl">デモを見る <b>30%</b></span></div>
      <div class="adv-pb" data-d="4"><span class="adv-pb-fill" style="width:55%;background:#888"></span><span class="adv-pb-lbl">議論する <b>50%</b></span></div>
      <div class="adv-pb" data-d="5"><span class="adv-pb-fill" style="width:83%;background:#aaa"></span><span class="adv-pb-lbl">実践する <b>75%</b></span></div>
      <div class="adv-pb adv-pb--boss" data-d="6"><span class="adv-pb-fill" style="width:100%;background:var(--color-you-daidai)"></span><span class="adv-pb-lbl">問答法 <b>90%</b></span><span class="adv-pb-tag">← SSメソッド</span></div>
    </div>
  </section>

  <!-- ===== 6. FULL ACHIEVEMENTS ===== -->
  <section class="adv-achieve">
    <h2 class="adv-section-title adv-reveal" data-d="0">合格実績</h2>
    <div class="adv-achieve-grid">
      <div class="adv-achieve-block adv-reveal" data-d="0">
        <h3>国公立大学</h3>
        <div class="adv-names">{allAchievements.national.map(s => <span>{s}</span>)}</div>
      </div>
      <div class="adv-achieve-block adv-reveal" data-d="1">
        <h3>私立大学</h3>
        <div class="adv-names">{allAchievements.privateUni.map(s => <span>{s}</span>)}</div>
      </div>
      <div class="adv-achieve-block adv-reveal" data-d="2">
        <h3>公立高校</h3>
        <div class="adv-names">{allAchievements.publicHigh.map(s => <span>{s}</span>)}</div>
      </div>
    </div>
  </section>

  <!-- ===== 7. CTA ===== -->
  <section class="adv-cta">
    <div class="adv-cta-inner adv-reveal" data-d="0">
      <p class="adv-cta-text text-display">居場所から始まって、<br>どこまでも行ける。</p>
      <a href="/trial" class="adv-cta-btn">体験授業を申し込む</a>
    </div>
  </section>

</div>
</BaseLayout>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .adv { background: #080808; color: #eee; overflow: hidden; }

  /* ===== REVEAL ===== */
  .adv-reveal {
    opacity: 0;
    transform: translateY(50px) translateZ(0);
    transition: opacity 1s var(--ease-smooth, ease), transform 1.5s var(--ease-out-quart, ease);
    will-change: opacity, transform;
  }
  .adv-reveal.is-visible { opacity: 1; transform: translateY(0) translateZ(0); }

  /* ===== UTILITY ===== */
  .adv-label {
    display: block;
    font-family: var(--font-latin);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-you-daidai);
    margin-bottom: var(--space-md);
    text-align: center;
  }
  .adv-section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 400;
    color: #fff;
    text-align: center;
    margin-bottom: var(--space-sm);
    letter-spacing: 0.08em;
  }
  .adv-section-sub {
    text-align: center;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: #555;
    margin-bottom: var(--space-2xl);
  }

  /* ===== 2. IMPACT — 1校ずつドーンと ===== */
  .adv-impact {
    padding: var(--space-xl) var(--space-md);
    border-top: 1px solid rgba(255,255,255,0.04);
  }

  .adv-impact-intro {
    text-align: center;
    padding: var(--space-2xl) 0;
  }

  .adv-impact-label {
    display: block;
    font-family: var(--font-latin);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.5em;
    color: var(--color-you-daidai);
    margin-bottom: var(--space-md);
  }

  .adv-impact-lead {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: #555;
    letter-spacing: 0.1em;
  }

  /* Reel: each school gets its own full-width row */
  .adv-impact-reel {
    display: flex;
    flex-direction: column;
  }

  .adv-impact-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    min-height: 40vh;
    padding: var(--space-xl) var(--space-md);
    border-bottom: 1px solid rgba(255,255,255,0.03);
    /* Animation: starts invisible */
    opacity: 0;
    transform: scale(0.9) translateZ(0);
    transition: opacity 0.8s var(--ease-smooth, ease),
                transform 1.2s var(--ease-out-quart, ease);
    will-change: opacity, transform;
  }

  .adv-impact-slide.is-visible {
    opacity: 1;
    transform: scale(1) translateZ(0);
  }

  .adv-impact-school {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 7rem);
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.04em;
    line-height: 1;
    text-shadow: 0 0 60px rgba(255,107,53,0.12);
  }

  .adv-impact-tag {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: 0.2em;
    color: var(--color-you-daidai);
    border: 2px solid var(--color-you-daidai);
    padding: var(--space-xs) var(--space-md);
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.5s ease 0.6s, transform 0.5s var(--ease-out-quart, ease) 0.6s;
  }

  .adv-impact-slide.is-visible .adv-impact-tag {
    opacity: 1;
    transform: translateX(0);
  }

  /* Every other slide: school name slightly offset */
  .adv-impact-slide:nth-child(even) {
    flex-direction: row-reverse;
  }

  .adv-impact-close {
    text-align: center;
    padding: var(--space-2xl) 0;
  }

  .adv-impact-all {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 3rem);
    color: #fff;
    letter-spacing: 0.08em;
  }

  /* ===== 2. HERO ===== */
  .adv-hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-md);
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .adv-hero-content { text-align: center; }
  .adv-badge {
    display: inline-block;
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: 0.4em;
    padding: var(--space-sm) var(--space-2xl);
    border: 2px solid var(--color-you-daidai);
    color: var(--color-you-daidai);
    margin-bottom: var(--space-xl);
  }
  .adv-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 9rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.04em;
    color: #fff;
    margin-bottom: var(--space-lg);
  }
  .adv-sub {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 3vw, 2rem);
    color: #555;
    letter-spacing: 0.12em;
    line-height: 1.8;
  }

  /* ===== 3. PUNCHES ===== */
  .adv-punches {
    padding: var(--space-xl) var(--space-md);
    max-width: 1000px;
    margin: 0 auto;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .adv-punch {
    display: flex;
    align-items: baseline;
    gap: var(--space-xl);
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .adv-punch:last-child { border-bottom: none; }
  .adv-punch-num {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: clamp(5rem, 14vw, 12rem);
    line-height: 0.85;
    color: var(--color-you-daidai);
    letter-spacing: -0.04em;
    flex-shrink: 0;
  }
  .adv-punch-unit {
    font-size: 0.35em;
    color: #666;
    letter-spacing: 0;
  }
  .adv-punch-msg {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 400;
    color: #fff;
    margin-bottom: var(--space-xs);
    letter-spacing: 0.06em;
  }
  .adv-punch-sub {
    font-size: var(--text-base);
    color: #555;
    line-height: 1.6;
  }

  /* ===== 4. METHOD ===== */
  .adv-method {
    padding: var(--space-2xl) var(--space-md);
    max-width: 1100px;
    margin: 0 auto;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .adv-method-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }
  .adv-mcard {
    padding: var(--space-xl);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: var(--radius-md);
    position: relative;
    overflow: hidden;
    transition: border-color 0.5s, background 0.5s;
  }
  .adv-mcard::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 3px;
    background: var(--color-you-daidai);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out-quart, ease);
  }
  .adv-mcard:hover { border-color: var(--color-you-daidai); background: rgba(255,107,53,0.03); }
  .adv-mcard:hover::before { transform: scaleX(1); }
  .adv-mcard-num {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: clamp(3rem, 6vw, 5rem);
    color: rgba(255,255,255,0.04);
    display: block;
    line-height: 1;
    margin-bottom: var(--space-sm);
  }
  .adv-mcard h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    color: #fff;
    margin-bottom: var(--space-sm);
    letter-spacing: 0.05em;
  }
  .adv-mcard p { font-size: var(--text-base); color: #777; line-height: 1.8; }

  /* ===== 5. PYRAMID ===== */
  .adv-pyramid {
    padding: var(--space-2xl) var(--space-md);
    max-width: 800px;
    margin: 0 auto;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .adv-pbars {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: var(--space-xl);
  }
  .adv-pb {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    height: 36px;
  }
  .adv-pb--boss { height: 56px; margin-top: var(--space-sm); }
  .adv-pb-fill {
    height: 100%;
    flex-shrink: 0;
    border-radius: 0 4px 4px 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s var(--ease-out-quart, ease);
  }
  .adv-pb.is-visible .adv-pb-fill { transform: scaleX(1); }
  .adv-pb--boss .adv-pb-fill { box-shadow: 0 0 40px rgba(255,107,53,0.5); }
  .adv-pb-lbl {
    font-size: var(--text-sm);
    color: #555;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.5s ease 0.6s;
  }
  .adv-pb.is-visible .adv-pb-lbl { opacity: 1; }
  .adv-pb-lbl b { font-family: var(--font-latin); font-weight: 700; color: #999; margin-left: 4px; }
  .adv-pb--boss .adv-pb-lbl { font-size: var(--text-xl); color: #fff; font-weight: 700; }
  .adv-pb--boss .adv-pb-lbl b { color: var(--color-you-daidai); font-size: var(--text-3xl); }
  .adv-pb-tag {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-you-daidai);
    opacity: 0;
    transition: opacity 1s ease 1.5s;
    white-space: nowrap;
  }
  .adv-pb--boss.is-visible .adv-pb-tag { opacity: 1; }

  /* ===== 6. ACHIEVEMENTS ===== */
  .adv-achieve {
    padding: var(--space-2xl) var(--space-md);
    max-width: 1100px;
    margin: 0 auto;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .adv-achieve-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }
  .adv-achieve-block {
    padding: var(--space-xl);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: var(--radius-md);
  }
  .adv-achieve-block h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-you-daidai);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    letter-spacing: 0.06em;
  }
  .adv-names { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .adv-names span {
    font-size: var(--text-sm);
    padding: 3px 12px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 50px;
    color: #888;
    transition: all 0.3s;
  }
  .adv-names span:hover { border-color: var(--color-you-daidai); color: var(--color-you-daidai); }

  /* ===== 7. CTA ===== */
  .adv-cta {
    padding: var(--space-2xl) var(--space-md);
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .adv-cta-inner { text-align: center; }
  .adv-cta-text {
    font-size: clamp(2rem, 5vw, 4rem);
    color: #fff;
    line-height: 1.4;
    margin-bottom: var(--space-xl);
    letter-spacing: 0.06em;
  }
  .adv-cta-btn {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-xl);
    color: #080808;
    background: var(--color-you-daidai);
    padding: var(--space-md) var(--space-2xl);
    border-radius: var(--radius-md);
    box-shadow: 0 0 50px rgba(255,107,53,0.35);
    transition: all 0.3s;
  }
  .adv-cta-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 80px rgba(255,107,53,0.6);
    color: #080808;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .adv-punch { flex-direction: column; gap: var(--space-sm); }
    .adv-method-grid { grid-template-columns: 1fr; }
    .adv-achieve-grid { grid-template-columns: 1fr; }
    .adv-impact-schools { gap: var(--space-sm); }
    .adv-impact-school { font-size: clamp(1.2rem, 5vw, 2rem); }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.adv-reveal');
  const bars = document.querySelectorAll('.adv-pb');
  const slides = document.querySelectorAll('.adv-impact-slide');

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const d = parseInt(e.target.getAttribute('data-d') || '0');
      setTimeout(() => e.target.classList.add('is-visible'), d * 200);
    });
  }, { threshold: 0.1 });

  reveals.forEach(el => {
    if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visible');
    obs.observe(el);
  });

  const bObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const d = parseInt(e.target.getAttribute('data-d') || '0');
      setTimeout(() => e.target.classList.add('is-visible'), d * 150);
    });
  }, { threshold: 0.1 });

  bars.forEach(b => {
    if (b.getBoundingClientRect().top < window.innerHeight) b.classList.add('is-visible');
    bObs.observe(b);
  });

  // Impact slides — each school revealed individually
  const slideObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('is-visible');
    });
  }, { threshold: 0.3 });

  slides.forEach(s => {
    if (s.getBoundingClientRect().top < window.innerHeight) s.classList.add('is-visible');
    slideObs.observe(s);
  });
</script>
