---
import BaseLayout from '../layouts/BaseLayout.astro';

const achievements = {
  publicHigh: [
    '宇都宮高校', '栃木女子高校', '栃木高校', '宇都宮中央高校',
    '鹿沼高校', '鹿沼東高校', '宇都宮白楊', '小山工業高等専門学校',
  ],
  national: [
    '金沢大学', '群馬県立女子大学', '高知県立大学', '新潟県立大学',
    '会津大学', '長岡技術科学大学',
  ],
  privateUni: [
    '東京理科大学', '法政大学', '昭和女子大学', '国際医療福祉大学',
    '独協医科大学', 'フェリス女学院', '帝京大学',
  ],
};

const punches = [
  { number: '90', unit: '%', message: '定着率', sub: '問答法は「聞くだけ」の18倍記憶に残る' },
  { number: '30', unit: '年+', message: '実証済み', sub: '関東15塾の塾長が認めた体系化メソッド' },
  { number: '48', unit: 'h/年', message: 'テスト対策補習', sub: '定期テスト3週前から毎週末。完全無料。' },
  { number: '100', unit: 'h/年', message: '講師研修', sub: '教える技術を磨き続ける。妥協なし。' },
];
---

<BaseLayout
  title="アドバンス — 学習超特急 | S&Sセミナー"
  description="居場所の先に広がる、成績にこだわる世界。SSメソッド（問答法）で宇都宮高校、東京理科大学など難関校への合格実績。"
>
  <!-- Full dark page wrapper -->
  <div class="adv">

    <!-- ===== HERO: 漆黒の中から文字が浮かび上がる ===== -->
    <section class="adv-hero">
      <div class="adv-hero-noise" aria-hidden="true"></div>
      <div class="adv-hero-content">
        <span class="adv-badge adv-reveal" data-d="0">ADVANCE</span>
        <h1 class="adv-hero-title adv-reveal" data-d="1">
          居場所の、<br>その先。
        </h1>
        <p class="adv-hero-sub adv-reveal" data-d="2">
          安心が生まれたら、次は全速力だ。
        </p>
        <div class="adv-hero-line adv-reveal" data-d="3" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ===== PUNCH MESSAGES: シングルメッセージをドンドン叩きつける ===== -->
    <section class="adv-punches">
      {punches.map((p, i) => (
        <div class="adv-punch adv-reveal" data-d={i}>
          <div class="adv-punch-number">
            <span class="adv-punch-num">{p.number}</span>
            <span class="adv-punch-unit">{p.unit}</span>
          </div>
          <div class="adv-punch-text">
            <h2 class="adv-punch-message">{p.message}</h2>
            <p class="adv-punch-sub">{p.sub}</p>
          </div>
        </div>
      ))}
    </section>

    <!-- ===== METHOD: SSメソッドをガツンと ===== -->
    <section class="adv-method">
      <div class="adv-method-header adv-reveal" data-d="0">
        <span class="adv-method-label">THE METHOD</span>
        <h2 class="adv-method-title">SSメソッド</h2>
        <p class="adv-method-sub">答えは教えない。<br>問いかけで、引き出す。</p>
      </div>

      <div class="adv-method-grid">
        <div class="adv-method-card adv-reveal" data-d="0">
          <span class="adv-method-num">01</span>
          <h3>問答法</h3>
          <p>ソクラテス問答法。教師が一方的に教えるのではなく、質問で解のプロセスを生徒から引き出す。定着率は「聞くだけ」の18倍。</p>
        </div>
        <div class="adv-method-card adv-reveal" data-d="1">
          <span class="adv-method-num">02</span>
          <h3>24時間アクセス</h3>
          <p>全授業を録画・アーカイブ化。導入動画、授業要約、宿題確認が自宅からいつでも可能。欠席しても絶対に置いていかない。</p>
        </div>
        <div class="adv-method-card adv-reveal" data-d="2">
          <span class="adv-method-num">03</span>
          <h3>オリジナル教材10種+</h3>
          <p>問答法に最適化。暗記を最小化する設計。2-4-7の法則で海馬に長期記憶として刻む。</p>
        </div>
        <div class="adv-method-card adv-reveal" data-d="3">
          <span class="adv-method-num">04</span>
          <h3>SS式進路指導</h3>
          <p>県内全校を訪問調査済み。元作新学院進路指導が常勤。入学後のミスマッチを防ぎ、就学継続を実現。</p>
        </div>
      </div>
    </section>

    <!-- ===== PYRAMID: 定着率をビジュアルで殴る ===== -->
    <section class="adv-pyramid">
      <div class="adv-pyramid-header adv-reveal" data-d="0">
        <h2>なぜ、問答法か。</h2>
      </div>
      <div class="adv-pyramid-bars" id="pyramid">
        <div class="adv-pbar" data-d="0" style="--w: 5%"><span class="adv-pbar-fill" style="--c: #4a4a4a"></span><span class="adv-pbar-label">聞くだけ <strong>5%</strong></span></div>
        <div class="adv-pbar" data-d="1" style="--w: 11%"><span class="adv-pbar-fill" style="--c: #5a5a5a"></span><span class="adv-pbar-label">読む <strong>10%</strong></span></div>
        <div class="adv-pbar" data-d="2" style="--w: 22%"><span class="adv-pbar-fill" style="--c: #6a6a6a"></span><span class="adv-pbar-label">視聴覚 <strong>20%</strong></span></div>
        <div class="adv-pbar" data-d="3" style="--w: 33%"><span class="adv-pbar-fill" style="--c: #7a7a7a"></span><span class="adv-pbar-label">デモを見る <strong>30%</strong></span></div>
        <div class="adv-pbar" data-d="4" style="--w: 55%"><span class="adv-pbar-fill" style="--c: #8a8a8a"></span><span class="adv-pbar-label">議論する <strong>50%</strong></span></div>
        <div class="adv-pbar" data-d="5" style="--w: 83%"><span class="adv-pbar-fill" style="--c: #aaa"></span><span class="adv-pbar-label">実践する <strong>75%</strong></span></div>
        <div class="adv-pbar adv-pbar--hero" data-d="6" style="--w: 100%"><span class="adv-pbar-fill" style="--c: var(--color-you-daidai)"></span><span class="adv-pbar-label">問答法 <strong>90%</strong></span><span class="adv-pbar-tag">SSメソッド</span></div>
      </div>
    </section>

    <!-- ===== ACHIEVEMENTS: 合格実績を叩きつける ===== -->
    <section class="adv-achieve">
      <div class="adv-achieve-header adv-reveal" data-d="0">
        <h2>合格実績</h2>
        <p>居場所から始まった子どもたちが、ここまで到達する。</p>
      </div>
      <div class="adv-achieve-grid">
        <div class="adv-achieve-block adv-reveal" data-d="0">
          <h3>国公立大学</h3>
          <div class="adv-achieve-names">{achievements.national.map(s => <span>{s}</span>)}</div>
        </div>
        <div class="adv-achieve-block adv-reveal" data-d="1">
          <h3>私立大学</h3>
          <div class="adv-achieve-names">{achievements.privateUni.map(s => <span>{s}</span>)}</div>
        </div>
        <div class="adv-achieve-block adv-reveal" data-d="2">
          <h3>公立高校</h3>
          <div class="adv-achieve-names">{achievements.publicHigh.map(s => <span>{s}</span>)}</div>
        </div>
      </div>
    </section>

    <!-- ===== CTA: 最後の一撃 ===== -->
    <section class="adv-final">
      <div class="adv-final-content adv-reveal" data-d="0">
        <p class="adv-final-text text-display">居場所から始まって、<br>どこまでも行ける。</p>
        <a href="/trial" class="adv-final-btn">体験授業を申し込む</a>
      </div>
    </section>

  </div>
</BaseLayout>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  /* ===== DARK WORLD ===== */
  .adv {
    background: #0a0a0a;
    color: #f0f0f0;
    overflow: hidden;
  }

  /* ===== REVEAL ANIMATION ===== */
  .adv-reveal {
    opacity: 0;
    transform: translateY(40px) translateZ(0);
    transition: opacity 0.8s var(--ease-smooth, ease),
                transform 1.2s var(--ease-out-quart, ease);
    will-change: opacity, transform;
  }

  .adv-reveal.is-visible {
    opacity: 1;
    transform: translateY(0) translateZ(0);
  }

  /* ===== HERO ===== */
  .adv-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--nav-height);
    overflow: hidden;
  }

  .adv-hero-noise {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-repeat: repeat;
    pointer-events: none;
  }

  .adv-hero-content {
    text-align: center;
    padding: var(--space-xl);
  }

  .adv-badge {
    display: inline-block;
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.4em;
    padding: var(--space-xs) var(--space-xl);
    border: 2px solid var(--color-you-daidai);
    color: var(--color-you-daidai);
    margin-bottom: var(--space-xl);
  }

  .adv-hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.05em;
    color: #fff;
    margin-bottom: var(--space-lg);
  }

  .adv-hero-sub {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: #999;
    letter-spacing: 0.1em;
  }

  .adv-hero-line {
    width: 1px;
    height: 80px;
    background: var(--color-you-daidai);
    margin: var(--space-2xl) auto 0;
    animation: line-grow 2s var(--ease-out-quart, ease) forwards;
    transform-origin: top;
    transform: scaleY(0);
  }

  .adv-hero-line.is-visible {
    transform: scaleY(1);
  }

  @keyframes line-grow {
    to { transform: scaleY(1); }
  }

  /* ===== PUNCH MESSAGES ===== */
  .adv-punches {
    padding: var(--space-2xl) var(--space-md);
    max-width: 900px;
    margin: 0 auto;
  }

  .adv-punch {
    display: flex;
    align-items: baseline;
    gap: var(--space-xl);
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .adv-punch:last-child { border-bottom: none; }

  .adv-punch-number {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .adv-punch-num {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 1;
    color: var(--color-you-daidai);
    letter-spacing: -0.03em;
  }

  .adv-punch-unit {
    font-family: var(--font-latin);
    font-weight: 500;
    font-size: var(--text-xl);
    color: #666;
  }

  .adv-punch-message {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: #fff;
    margin-bottom: var(--space-xs);
    letter-spacing: 0.05em;
  }

  .adv-punch-sub {
    font-size: var(--text-sm);
    color: #777;
    line-height: 1.6;
  }

  /* ===== METHOD ===== */
  .adv-method {
    padding: var(--space-2xl) var(--space-md);
    max-width: 1100px;
    margin: 0 auto;
  }

  .adv-method-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .adv-method-label {
    font-family: var(--font-latin);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--color-you-daidai);
    display: block;
    margin-bottom: var(--space-md);
  }

  .adv-method-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    color: #fff;
    margin-bottom: var(--space-md);
    letter-spacing: 0.08em;
  }

  .adv-method-sub {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: #666;
    line-height: 1.8;
  }

  .adv-method-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .adv-method-card {
    padding: var(--space-xl);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-md);
    transition: border-color 0.5s ease, background 0.5s ease;
    position: relative;
    overflow: hidden;
  }

  .adv-method-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--color-you-daidai);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out-quart, ease);
  }

  .adv-method-card:hover {
    border-color: var(--color-you-daidai);
    background: rgba(255, 107, 53, 0.03);
  }

  .adv-method-card:hover::before {
    transform: scaleX(1);
  }

  .adv-method-num {
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: var(--text-3xl);
    color: rgba(255,255,255,0.06);
    display: block;
    margin-bottom: var(--space-sm);
    line-height: 1;
  }

  .adv-method-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    color: #fff;
    margin-bottom: var(--space-sm);
    letter-spacing: 0.04em;
  }

  .adv-method-card p {
    font-size: var(--text-sm);
    color: #888;
    line-height: 1.8;
  }

  /* ===== PYRAMID ===== */
  .adv-pyramid {
    padding: var(--space-2xl) var(--space-md);
    max-width: 800px;
    margin: 0 auto;
  }

  .adv-pyramid-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .adv-pyramid-header h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.08em;
  }

  .adv-pyramid-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .adv-pbar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    height: 32px;
  }

  .adv-pbar--hero {
    height: 52px;
    margin-top: var(--space-sm);
  }

  .adv-pbar-fill {
    height: 100%;
    width: var(--w);
    background: var(--c);
    border-radius: 0 4px 4px 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s var(--ease-out-quart, ease);
    flex-shrink: 0;
  }

  .adv-pbar.is-visible .adv-pbar-fill {
    transform: scaleX(1);
  }

  .adv-pbar--hero .adv-pbar-fill {
    box-shadow: 0 0 30px rgba(255, 107, 53, 0.4);
  }

  .adv-pbar-label {
    font-size: var(--text-sm);
    color: #666;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.5s ease 0.5s, transform 0.5s ease 0.5s;
  }

  .adv-pbar.is-visible .adv-pbar-label {
    opacity: 1;
    transform: translateX(0);
  }

  .adv-pbar-label strong {
    font-family: var(--font-latin);
    font-weight: 700;
    color: #aaa;
    margin-left: 4px;
  }

  .adv-pbar--hero .adv-pbar-label {
    font-size: var(--text-lg);
    font-weight: 700;
    color: #fff;
  }

  .adv-pbar--hero .adv-pbar-label strong {
    color: var(--color-you-daidai);
    font-size: var(--text-2xl);
  }

  .adv-pbar-tag {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-you-daidai);
    opacity: 0;
    transition: opacity 0.8s ease 1.2s;
    white-space: nowrap;
  }

  .adv-pbar--hero.is-visible .adv-pbar-tag {
    opacity: 1;
  }

  /* ===== ACHIEVEMENTS ===== */
  .adv-achieve {
    padding: var(--space-2xl) var(--space-md);
    max-width: 1100px;
    margin: 0 auto;
  }

  .adv-achieve-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .adv-achieve-header h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-sm);
  }

  .adv-achieve-header p {
    font-size: var(--text-sm);
    color: #666;
  }

  .adv-achieve-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .adv-achieve-block {
    padding: var(--space-xl);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-md);
  }

  .adv-achieve-block h3 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-you-daidai);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    letter-spacing: 0.06em;
  }

  .adv-achieve-names {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .adv-achieve-names span {
    font-size: var(--text-sm);
    padding: 2px 10px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50px;
    color: #999;
    transition: all 0.3s ease;
  }

  .adv-achieve-names span:hover {
    border-color: var(--color-you-daidai);
    color: var(--color-you-daidai);
  }

  /* ===== FINAL CTA ===== */
  .adv-final {
    padding: var(--space-2xl) var(--space-md);
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .adv-final-content {
    text-align: center;
  }

  .adv-final-text {
    font-size: clamp(1.5rem, 4vw, 3rem);
    color: #fff;
    line-height: 1.5;
    margin-bottom: var(--space-xl);
    letter-spacing: 0.06em;
  }

  .adv-final-btn {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
    color: #0a0a0a;
    background: var(--color-you-daidai);
    padding: var(--space-md) var(--space-2xl);
    border-radius: var(--radius-md);
    transition: all 0.3s var(--ease-smooth, ease);
    box-shadow: 0 0 40px rgba(255, 107, 53, 0.3);
  }

  .adv-final-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 60px rgba(255, 107, 53, 0.5);
    color: #0a0a0a;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .adv-punch {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .adv-method-grid {
      grid-template-columns: 1fr;
    }

    .adv-achieve-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Reveal on scroll — staggered per data-d attribute
  const reveals = document.querySelectorAll('.adv-reveal');
  const bars = document.querySelectorAll('.adv-pbar');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const d = parseInt(entry.target.getAttribute('data-d') || '0');
        setTimeout(() => entry.target.classList.add('is-visible'), d * 200);
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -5% 0px' }
  );

  reveals.forEach(el => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight && rect.bottom > 0) {
      el.classList.add('is-visible');
    }
    observer.observe(el);
  });

  // Pyramid bars
  const barObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const d = parseInt(entry.target.getAttribute('data-d') || '0');
        setTimeout(() => entry.target.classList.add('is-visible'), d * 150);
      });
    },
    { threshold: 0.1 }
  );

  bars.forEach(bar => {
    const rect = bar.getBoundingClientRect();
    if (rect.top < window.innerHeight && rect.bottom > 0) {
      bar.classList.add('is-visible');
    }
    barObserver.observe(bar);
  });
</script>
